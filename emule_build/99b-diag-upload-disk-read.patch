-		} while (::GetQueuedCompletionStatus(m_hPort, &dwRead, &completionKey, (LPOVERLAPPED*)&pCurIO, 0));
+		} while (DiagGetQueuedCompletionStatus(m_hPort, dwRead, completionKey, pCurIO, 0));
 
 		if (!completionKey) //thread termination
