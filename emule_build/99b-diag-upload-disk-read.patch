--- a/srchybrid/UploadDiskIOThread.cpp
+++ b/srchybrid/UploadDiskIOThread.cpp
@@ -45,6 +45,34 @@ static char THIS_FILE[] = __FILE__;
 #define RUN_WORK	2
 #define WAKEUP		((ULONG_PTR)(~0))
 
+// 99b: a read that takes this long holds up every upload, see ReadCompletionRoutine()
+#define DIAG_SLOW_READ_MS	SEC2MS(10)
+
+// 99b: GetQueuedCompletionStatus() also returns FALSE when the packet it hands over is a read
+// that failed. Both loops in RunInternal() take that FALSE as the end: the waiting loop ends the
+// thread, the draining loop ends the drain and the failed read is never completed, so it stays
+// pending and WakeUpCall() never posts again. Either way no upload gets data from then on.
+// Only the main log is told; what the loops do is unchanged.
+static BOOL DiagGetQueuedCompletionStatus(HANDLE hPort, DWORD &dwRead, ULONG_PTR &completionKey, OverlappedRead_Struct *&pCurIO, DWORD dwWait)
+{
+	const BOOL bRet = ::GetQueuedCompletionStatus(hPort, &dwRead, &completionKey, (LPOVERLAPPED*)&pCurIO, dwWait);
+	if (!bRet) {
+		const DWORD dwError = ::GetLastError();
+		if (pCurIO != NULL)
+			theApp.QueueLogLineEx(LOG_ERROR, _T("Upload disk I/O: reading \"%s\" at %I64u-%I64u failed after %lu ms, error %lu: %s - %s")
+				, (LPCTSTR)pCurIO->pFile->GetFileName(), pCurIO->uStartOffset, pCurIO->uEndOffset
+				, ::GetTickCount() - pCurIO->dwDiagStart, dwError, (LPCTSTR)GetErrorMessage(dwError, 1)
+				, dwWait == INFINITE ? _T("the upload read thread stops, no upload should get data until eMule restarts")
+					: _T("the read stays pending for good, uploads should stall once the reads in flight are done"));
+		else if (dwError != WAIT_TIMEOUT)
+			theApp.QueueLogLineEx(LOG_ERROR, _T("Upload disk I/O: GetQueuedCompletionStatus failed, error %lu: %s - %s")
+				, dwError, (LPCTSTR)GetErrorMessage(dwError, 1)
+				, dwWait == INFINITE ? _T("the upload read thread stops, no upload should get data until eMule restarts") : _T("draining stops"));
+		::SetLastError(dwError);
+	}
+	return bRet;
+}
+
 IMPLEMENT_DYNCREATE(CUploadDiskIOThread, CWinThread)
 
 CUploadDiskIOThread::CUploadDiskIOThread()
