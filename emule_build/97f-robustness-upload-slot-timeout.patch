@@ -53,7 +53,8 @@ static char THIS_FILE[] = __FILE__;
 IMPLEMENT_DYNCREATE(CClientReqSocket, CEMSocket)
 
 CClientReqSocket::CClientReqSocket(CUpDownClient *in_client)
-	: deltimer()
+	: m_uLastTimeOut()
+	, deltimer()
 	, m_nOnConnect(SS_Other)
 	, deletethis()
 	, m_bPortTestCon()
@@ -134,16 +135,31 @@ bool CClientReqSocket::CheckTimeOut()
 		return true;
 	}
 	DWORD uTimeout = GetTimeOut();
+	const DWORD uSendAge = GetSendBlockedAge();	//0 when the socket can still take data
 	if (client)
 		if (client->GetKadState() == KS_CONNECTED_BUDDY)
 			uTimeout += MIN2MS(15);
-		else if (client->IsDownloading() && curTick < client->GetUpStartTime() + 4 * CONNECTION_TIMEOUT)
-			//TCP flow control might need more time to begin throttling for slow peers
+		else if (client->IsDownloading() && uSendAge > 0 && uSendAge < 4 * CONNECTION_TIMEOUT)
+			//TCP flow control might need more time to begin throttling for slow peers. That is
+			//this socket, and it can say so itself: while a send is still with the operating
+			//system the connection is not idle, however long nothing has moved on it. Asking
+			//instead how old the upload slot is grants the extra time to slots that are not
+			//held up at all and withholds it from the ones that are. The bound keeps the whole
+			//allowance at what the age of the slot already allowed.
 			uTimeout += 4 * CONNECTION_TIMEOUT; //2'30" or slightly more
 		else if (client->GetChatState() != MS_NONE)
 			//We extend the timeout time here to avoid chatting people from disconnecting too fast.
 			uTimeout += CONNECTION_TIMEOUT;
 
+	//The allowance is not a constant: an extension stops applying as soon as the condition that
+	//granted it stops being true, and the allowance then drops by that whole extension between
+	//one call and the next. The time already spent was spent against the larger allowance, so
+	//comparing it with the smaller one ends the connection in the same instant, without it ever
+	//having had the smaller allowance to spend. Start counting again from the moment it shrinks.
+	if (uTimeout < m_uLastTimeOut && curTick - timeout_timer >= uTimeout)
+		timeout_timer = curTick;
+	m_uLastTimeOut = uTimeout;
+
 	if (curTick < timeout_timer + uTimeout)
 		return false;
 	timeout_timer = curTick;
