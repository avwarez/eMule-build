+// the same condition as above, plus how long it has lasted
+DWORD CEMSocket::GetSendBlockedAge() const
+{
+	if (m_dwSendBlockedSince == 0 || !IsBusyQuickCheck())
+		return 0;
+	// never report 0 while the state holds, so the caller can read the value as a flag as well
+	return max(::GetTickCount() - m_dwSendBlockedSince, 1ul);
+}
