diff --git a/srchybrid/EMSocket.h b/srchybrid/EMSocket.h
index 3875a13..8fa966f 100644
--- a/srchybrid/EMSocket.h
+++ b/srchybrid/EMSocket.h
@@ -78,6 +78,14 @@ public:
 	uint32 GetSentPayloadSinceLastCall(bool bReset);
 	void TruncateQueues();
 
+	// How long this socket has been unable to take more data, in milliseconds, and 0 when it
+	// can. It answers for the same condition the quick busy check reports, in both send modes,
+	// and adds only how long it has lasted. A socket in that state is not an idle socket: the
+	// data is queued and the send completes as soon as the peer makes room for it. The value is
+	// written on the transitions into and out of the state, so reading it without the send lock
+	// is the same unsynchronized read the quick busy check already makes of the flag itself.
+	DWORD GetSendBlockedAge() const;
+
 	virtual SocketSentBytes SendControlData(uint32 maxNumberOfBytesToSend, uint32 minFragSize)			{ return SendEM(maxNumberOfBytesToSend, minFragSize, true); }
 	virtual SocketSentBytes SendFileAndControlData(uint32 maxNumberOfBytesToSend, uint32 minFragSize)	{ return SendEM(maxNumberOfBytesToSend, minFragSize, false); }
 
@@ -148,4 +156,5 @@ private:
 	bool	m_bUseBigSendBuffers;
 	bool	m_bUseOverlappedSend;
 	bool	m_bPendingSendOv;
+	DWORD	m_dwSendBlockedSince;
 };
