+
+	// the server we are logged in to as a LowID, when it coordinates punches; main thread. Its UDP
+	// key for our IP and its UDP port for obfuscated packets are eMule's, in the server list, where
+	// its answer to an obfuscated status request puts them (CUDPSocket, OP_GLOBSERVSTATRES)
+	struct SServer
+	{
+		uint32	dwIP = 0;			// network order; 0: none
