+// 99a-diag-upload-standdown (temporary): what the stand-down flag changed in one pick of
+// FindBestClientInQueue(). pSkipped, the best client passed over for the flag, would have won
+// the pick when its score beats the chosen one; the slot then goes to a lower score, or stays
+// empty when nobody else can take it. A run of empty picks (one every 100 ms while a slot is
+// free) is reported once: "empty" at its first pick, "emptyend" at the first pick after it,
+// with dur = first to last empty pick.
+static void DiagStandDownPick(CUpDownClient *pSkipped, uint32 uSkippedScore, const CUpDownClient *pChosen, uint32 uChosenScore, INT_PTR nWaiting)
+{
+	static bool s_bEmpty = false;
+	static DWORD s_dwEmptyFirst = 0;
+	static DWORD s_dwEmptyLast = 0;
+	static UINT s_uEmptyPicks = 0;
+	const bool bWins = pSkipped != NULL && uSkippedScore > uChosenScore;
+	const bool bEmpty = bWins && pChosen == NULL;
+	if (bWins)
+		pSkipped->DiagStandDownWouldWin(bEmpty);
+	if (bEmpty) {
+		s_dwEmptyLast = ::GetTickCount();
+		if (!s_bEmpty) {
+			s_bEmpty = true;
+			s_dwEmptyFirst = s_dwEmptyLast;
+			s_uEmptyPicks = 0;
+			AddDebugLogLine(false, _T("UPDIAG|standdown empty: a free upload slot is left empty for a stood-down client, waiting=%u Client: %s")
+				, (UINT)nWaiting, (LPCTSTR)pSkipped->DbgGetClientInfo());
+		}
+		++s_uEmptyPicks;
+	} else if (s_bEmpty) {
+		s_bEmpty = false;
+		AddDebugLogLine(false, _T("UPDIAG|standdown emptyend: dur=%us picks=%u next=%s")
+			, (s_dwEmptyLast - s_dwEmptyFirst) / SEC2MS(1), s_uEmptyPicks, pChosen != NULL ? _T("client") : _T("nobody"));
+	}
+}
