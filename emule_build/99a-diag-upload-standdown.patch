+// 99a-diag-upload-standdown (temporary) ------------------------------------------------------
+// Lines "UPDIAG|standdown <event>:" in the verbose log; with Verbose off AddDebugLogLine
+// writes nothing. Per client and per stand-down:
+//   begin   OP_OUTOFPARTREQS sent: the session it ended, what we download from this client,
+//           the waiting clients at that moment and how many of them were stood down too
+//   pick    the first pick of a free upload slot this client would have won without the flag
+//   reask   the first OP_STARTUPLOADREQ it sent while stood down
+//   end     the flag fell: why, how long it lasted, the picks it would have won, the time from
+//           the first of them (denied), the re-asks, src=1 if we were downloading from it at
+//           the start
+// and then, once: slot (its next upload slot, how long after the end) and slotend (what that
+// slot carried, up=0 is a slot that never started).
+
+void CUpDownClient::DiagStandDownBegin()
+{
+	m_bDiagSd = true;
+	m_bDiagSdWon = false;
+	m_bDiagSdEnded = false;
+	m_dwDiagSdBegin = ::GetTickCount();
+	m_uDiagSdWins = 0;
+	m_uDiagSdReasks = 0;
+	m_bDiagSdSource = (GetDownloadState() == DS_DOWNLOADING);
+	if (!thePrefs.GetVerbose())
+		return;
+	UINT uWaiting = 0;
+	UINT uStoodDown = 0;
+	for (POSITION pos = theApp.uploadqueue->GetFirstFromWaitingList(); pos != NULL;) {
+		++uWaiting;
+		if (theApp.uploadqueue->GetNextFromWaitingList(pos)->HasSentOutOfPartReqs())
+			++uStoodDown;
+	}
+	AddDebugLogLine(false, _T("UPDIAG|standdown begin: session=%us up=%I64u dl=%s waiting=%u stooddown=%u Client: %s")
+		, GetUpStartTimeDelay() / SEC2MS(1), GetSessionUp(), DbgGetDownloadState()
+		, uWaiting, uStoodDown, (LPCTSTR)DbgGetClientInfo());
+}
+
+void CUpDownClient::DiagStandDownWouldWin(bool bSlotLeftEmpty)
+{
+	if (!m_bDiagSd)
+		return;
+	++m_uDiagSdWins;
+	if (m_bDiagSdWon)
+		return;
+	m_bDiagSdWon = true;
+	m_dwDiagSdFirstWin = ::GetTickCount();
+	AddDebugLogLine(false, _T("UPDIAG|standdown pick: after=%us slot=%s dl=%s Client: %s")
+		, (m_dwDiagSdFirstWin - m_dwDiagSdBegin) / SEC2MS(1)
+		, bSlotLeftEmpty ? _T("left-empty") : _T("to-lower-score")
+		, DbgGetDownloadState(), (LPCTSTR)DbgGetClientInfo());
+}
+
+void CUpDownClient::DiagStandDownReask()
+{
+	if (!m_bDiagSd)
+		return;
+	if (m_uDiagSdReasks++ == 0)
+		AddDebugLogLine(false, _T("UPDIAG|standdown reask: after=%us dl=%s Client: %s")
+			, (::GetTickCount() - m_dwDiagSdBegin) / SEC2MS(1), DbgGetDownloadState(), (LPCTSTR)DbgGetClientInfo());
+}
+
+void CUpDownClient::DiagStandDownEnd(LPCTSTR pszReason)
+{
+	if (!m_bDiagSd)
+		return;
+	m_bDiagSd = false;
+	m_bDiagSdEnded = true;
+	m_dwDiagSdEnd = ::GetTickCount();
+	const DWORD dwDenied = m_bDiagSdWon ? (m_dwDiagSdEnd - m_dwDiagSdFirstWin) / SEC2MS(1) : 0;
+	AddDebugLogLine(false, _T("UPDIAG|standdown end: dur=%us picks=%u denied=%us reasks=%u src=%u dl=%s why=\"%s\" Client: %s")
+		, (m_dwDiagSdEnd - m_dwDiagSdBegin) / SEC2MS(1), m_uDiagSdWins, dwDenied, m_uDiagSdReasks
+		, m_bDiagSdSource ? 1u : 0u, DbgGetDownloadState(), pszReason != NULL ? pszReason : _T("")
+		, (LPCTSTR)DbgGetClientInfo());
+}
+
+void CUpDownClient::DiagUploadSlotBegin()
+{
+	DiagStandDownEnd(_T("upload slot given while stood down"));
+	if (!m_bDiagSdEnded)
+		return;
+	m_bDiagSdEnded = false;
+	m_bDiagSlotAfterSd = true;
+	AddDebugLogLine(false, _T("UPDIAG|standdown slot: after=%us dl=%s Client: %s")
+		, (::GetTickCount() - m_dwDiagSdEnd) / SEC2MS(1), DbgGetDownloadState(), (LPCTSTR)DbgGetClientInfo());
+}
+
+void CUpDownClient::DiagUploadSlotEnd()
+{
+	if (!m_bDiagSlotAfterSd)
+		return;
+	m_bDiagSlotAfterSd = false;
+	AddDebugLogLine(false, _T("UPDIAG|standdown slotend: session=%us up=%I64u Client: %s")
+		, GetUpStartTimeDelay() / SEC2MS(1), GetSessionUp(), (LPCTSTR)DbgGetClientInfo());
+}
+// end of 99a ---------------------------------------------------------------------------------
