+//Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+#pragma once
+#include <list>
+#include <map>
+#include <vector>
+#include "AsyncSocketExLayer.h"
+
+// The eD2K stream between two clients that carry hole punching, over uTP (libutp) on the
+// client UDP port instead of over TCP. A CClientReqSocket gets a CPunchSocketLayer before
+// Create(): above it nothing changes, below it there is no TCP connection, only a uTP one.
+//
+// Every punch datagram starts with OP_UDPRESERVEDPROT1, the header byte eMule reserved for
+// later UDP protocols: UDP obfuscation never picks it as its random first byte, and other
+// clients drop it as an unknown protocol. The second byte tells what follows.
+#define PUNCHPKT_UTP			0x01	// a uTP packet
+#define PUNCHPKT_KEEPALIVE		0x02	// nothing; keeps the NAT mapping of a session open
+
+class CClientReqSocket;
+class CPunchSocketLayer;
+struct UTPSocket;
+struct struct_utp_context;
+struct CPunchCallbacks;
+
+// One uTP connection. Owned by CPunchTransport; outlives its layer until libutp is done with it.
+struct SPunchSession
+{
+	UTPSocket			*pUtp;			// NULL once libutp destroyed it
+	CPunchSocketLayer	*pLayer;		// NULL once the socket is gone
+	uint32				dwIP;			// network order
+	uint16				nPort;			// host order, the UDP port of the peer
+	bool				bIncoming;
+	bool				bConnected;
+	bool				bEof;			// the peer closed its side
+	bool				bWantWrite;		// a Send() found the window full
+	bool				bReadPosted;	// an FD_READ is on its way to the socket
+	bool				bClosePosted;
+	long				lPendingEvents;	// FD_* raised by libutp, raised to the socket by the main thread
+	int					nPendingError;
+	std::vector<BYTE>	rx;				// received, not yet read by the socket
+	size_t				nRxRead;
+	DWORD				dwStarted;
+	DWORD				dwLastSent;
+	DWORD				dwLastRecv;
+	uint64				nBytesIn;		// stream bytes
+	uint64				nBytesOut;
+};
+
+struct SPunchTransportStats
+{
+	uint32	uPacketsIn;			// uTP datagrams passed to libutp
+	uint32	uPacketsOut;
+	uint32	uKeepalivesIn;
+	uint32	uKeepalivesOut;
+	uint32	uDroppedGate;		// from an endpoint not allowed
+	uint32	uDroppedShort;
+	uint32	uDroppedUnknown;	// unknown punch packet type
+	uint32	uSendFailed;
+	uint32	uConnects;			// sessions opened by us
+	uint32	uAccepts;			// sessions opened by the peer
+	uint32	uRefused;			// incoming sessions refused (gate, limits)
+	uint32	uConnectFailed;
+	uint32	uClosed;
+};
+
+class CPunchTransport
+{
+	friend CPunchCallbacks;
+public:
+	CPunchTransport();
+	~CPunchTransport();
+
+	// main thread
+	void	ProcessPacket(const BYTE *pPacket, int nLen, uint32 dwIP, uint16 nPort);
+	void	Process();
+	bool	AttachOutgoing(CClientReqSocket *pSocket, uint32 dwIP);
+	bool	IsAllowed(uint32 dwIP) const;
+
+	// CPunchSocketLayer; Write() also from the upload throttler thread
+	SPunchSession* Connect(CPunchSocketLayer *pLayer, uint32 dwIP, uint16 nPort);
+	int		Write(SPunchSession *pSession, const void *pBuf, int nLen);
+	int		Read(SPunchSession *pSession, void *pBuf, int nLen);
+	void	Detach(SPunchSession *pSession);
+
+	const SPunchTransportStats& GetStats() const	{ return m_stats; }
+	size_t	GetSessionCount() const					{ return m_listSessions.size(); }
+
+private:
+	void	LoadBenchPeers();
+	void	SendRaw(uint32 dwIP, uint16 nPort, BYTE byType, const BYTE *pData, size_t nLen);
+	void	RaiseEvents();
+	SPunchSession* NewSession(UTPSocket *pUtp, uint32 dwIP, uint16 nPort, bool bIncoming);
+	void	DeleteSession(SPunchSession *pSession);
+
+	struct_utp_context	*m_pCtx;
+	CCriticalSection	m_cs;		// every libutp call, and the sessions
+	std::list<SPunchSession*> m_listSessions;
+	std::list<std::pair<SPunchSession*, DWORD>> m_listDead;	// ended, freed after PUNCH_DEAD_DELAY
+	std::map<uint32, uint16> m_mapAllowed;	// IP -> UDP port to reach it (PunchBenchPeers)
+	SPunchTransportStats m_stats;
+};
+
+class CPunchSocketLayer : public CAsyncSocketExLayer
+{
+public:
+	CPunchSocketLayer(uint32 dwIP, uint16 nPort);
+	virtual	~CPunchSocketLayer();
+
+	void	Accepted(SPunchSession *pSession);
+	void	RaiseEvent(long lEvent, int nErrorCode);
+	void	Orphan()								{ m_pSession = NULL; }
+	SPunchSession* GetSession() const				{ return m_pSession; }
+
+protected:
+	// Events of the socket handle under this layer: there is no connection on it, so there are none
+	// to pass on. The events of the uTP connection skip the layer (RaiseEvent).
+	virtual void OnAccept(int nErrorCode);
+	virtual void OnClose(int nErrorCode);
+	virtual void OnConnect(int nErrorCode);
+	virtual void OnReceive(int nErrorCode);
+	virtual void OnSend(int nErrorCode);
+
+	virtual void Close();
+	virtual BOOL Connect(const LPSOCKADDR lpSockAddr, int nSockAddrLen);
+	virtual bool Connect(const CString &sHostAddress, UINT nHostPort);
+	virtual BOOL GetPeerName(CString &rPeerAddress, UINT &rPeerPort);
+	virtual BOOL GetPeerName(LPSOCKADDR lpPeerAddr, int *lpPeerAddrLen);
+	virtual int Receive(void *lpBuf, int nBufLen, int nFlags = 0);
+	virtual int Send(const void *lpBuf, int nBufLen, int nFlags = 0);
+	virtual BOOL ShutDown(int nHow = CAsyncSocket::sends);
+
+private:
+	SPunchSession	*m_pSession;
+	uint32			m_dwIP;		// network order
+	uint16			m_nPort;	// host order
+};
