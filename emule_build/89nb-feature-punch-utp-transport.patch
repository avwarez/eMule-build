+
+#define PUNCH_MAX_SESSIONS		64
+#define PUNCH_KEEPALIVE			SEC2MS(20)	// NAT mappings of UDP often last 30 s only
+#define PUNCH_UDP_MTU			(1402 - 2)	// libutp's IPv4 default, less our two header bytes
+#define PUNCH_DEAD_DELAY		SEC2MS(10)	// a session freed this long after its end
+
+namespace
+{
+	uint32 IPOf(const struct sockaddr *pAddr)
+	{
+		return reinterpret_cast<const sockaddr_in*>(pAddr)->sin_addr.s_addr;
+	}
+
+	uint16 PortOf(const struct sockaddr *pAddr)
+	{
+		return ntohs(reinterpret_cast<const sockaddr_in*>(pAddr)->sin_port);
+	}
+
+	sockaddr_in SockAddr(uint32 dwIP, uint16 nPort)
+	{
+		sockaddr_in sa = {};
+		sa.sin_family = AF_INET;
+		sa.sin_addr.s_addr = dwIP;
+		sa.sin_port = htons(nPort);
+		return sa;
+	}
+
+	SPunchSession* SessionOf(utp_socket *pUtp)
+	{
+		return pUtp != NULL ? static_cast<SPunchSession*>(utp_get_userdata(pUtp)) : NULL;
+	}
+
+	CryptoPP::AutoSeededRandomPool s_random;
+}
+
+// libutp calls back from inside utp_process_udp, utp_check_timeouts, utp_write, utp_close,
+// that is with CPunchTransport::m_cs held. Nothing here raises a socket event directly:
+// the flags set are raised by RaiseEvents(), on the main thread.
+struct CPunchCallbacks
+{
+	static uint64 OnUtp(utp_callback_arguments *a)
+	{
+		CPunchTransport *pThis = static_cast<CPunchTransport*>(utp_context_get_userdata(a->context));
+		SPunchSession *pSession = SessionOf(a->socket);
+		switch (a->callback_type) {
+		case UTP_SENDTO:
+			pThis->SendRaw(IPOf(a->address), PortOf(a->address), PUNCHPKT_UTP, a->buf, a->len);
+			++pThis->m_stats.uPacketsOut;
+			if (pSession != NULL)
+				pSession->dwLastSent = ::GetTickCount();
+			break;
+		case UTP_ON_FIREWALL:
+			// nonzero refuses the incoming connection
+			if (!pThis->IsAllowed(IPOf(a->address)) || pThis->m_listSessions.size() >= PUNCH_MAX_SESSIONS
+				|| theApp.listensocket->TooManySockets(true))
+			{
+				++pThis->m_stats.uRefused;
+				return 1;
+			}
+			break;
+		case UTP_ON_ACCEPT:
+			OnAccept(pThis, a);
+			break;
+		case UTP_ON_READ:
+			if (pSession != NULL) {
+				pSession->rx.insert(pSession->rx.end(), a->buf, a->buf + a->len);
+				pSession->nBytesIn += a->len;
+				pSession->dwLastRecv = ::GetTickCount();
+				if (!pSession->bReadPosted)
+					pSession->lPendingEvents |= FD_READ;
+				// an accepted connection takes writes from the first data of the peer on,
+				// and libutp tells nothing when it does
+				if (pSession->bWantWrite) {
+					pSession->bWantWrite = false;
+					pSession->lPendingEvents |= FD_WRITE;
+				}
+			}
+			break;
+		case UTP_ON_STATE_CHANGE:
+			if (pSession != NULL)
+				OnStateChange(pThis, pSession, a->state);
+			break;
+		case UTP_ON_ERROR:
+			if (pSession != NULL) {
+				switch (a->error_code) {
+				case UTP_ECONNREFUSED:
+					pSession->nPendingError = WSAECONNREFUSED;
+					break;
+				case UTP_ETIMEDOUT:
+					pSession->nPendingError = WSAETIMEDOUT;
+					break;
+				default:
+					pSession->nPendingError = WSAECONNRESET;
+				}
+				if (pSession->bConnected)
+					pSession->lPendingEvents |= FD_CLOSE;
+				else {
+					pSession->lPendingEvents |= FD_CONNECT;
+					++pThis->m_stats.uConnectFailed;
+				}
+			}
+			break;
+		case UTP_GET_READ_BUFFER_SIZE:
+			return pSession != NULL ? pSession->rx.size() - pSession->nRxRead : 0;
+		case UTP_GET_UDP_MTU:
+			return PUNCH_UDP_MTU;
+		case UTP_GET_RANDOM:
+			return s_random.GenerateWord32();
+		}
+		return 0;
+	}
+
+	static void OnStateChange(CPunchTransport *pThis, SPunchSession *pSession, int iState)
+	{
+		switch (iState) {
+		case UTP_STATE_CONNECT:
+			pSession->bConnected = true;
+			pSession->lPendingEvents |= FD_CONNECT;
+			break;
+		case UTP_STATE_WRITABLE:
+			if (pSession->bWantWrite) {
+				pSession->bWantWrite = false;
+				pSession->lPendingEvents |= FD_WRITE;
+			}
+			break;
+		case UTP_STATE_EOF:
+			pSession->bEof = true;
+			pSession->lPendingEvents |= FD_CLOSE;
+			break;
+		case UTP_STATE_DESTROYING:
+			pSession->pUtp = NULL;
+			if (pSession->pLayer == NULL)
+				pThis->DeleteSession(pSession);
+			else if (!pSession->bEof && pSession->nPendingError == 0) {
+				pSession->nPendingError = WSAECONNRESET;
+				pSession->lPendingEvents |= pSession->bConnected ? FD_CLOSE : FD_CONNECT;
+			}
+		}
+	}
+
+	// Same steps as an accepted TCP connection in CListenSocket::OnAccept, but the socket has
+	// no TCP connection under it: the layer is the connection.
+	static void OnAccept(CPunchTransport *pThis, utp_callback_arguments *a)
+	{
+		SPunchSession *pSession = pThis->NewSession(a->socket, IPOf(a->address), PortOf(a->address), true);
+		pSession->bConnected = true; // no UTP_STATE_CONNECT comes for an incoming connection
+		++pThis->m_stats.uAccepts;
+		CClientReqSocket *pSocket = new CClientReqSocket;
+		CPunchSocketLayer *pLayer = new CPunchSocketLayer(pSession->dwIP, pSession->nPort);
+		pSocket->AttachPunchLayer(pLayer);
+		if (!pSocket->Create()) {
+			pSocket->Safe_Delete();
+			utp_close(a->socket);	// the session goes with it
+			return;
+		}
+		pLayer->Accepted(pSession);
+	}
+};
+
+///////////////////////////////////////////////////////////////////////////////
+// CPunchTransport
+
+CPunchTransport::CPunchTransport()
+	: m_stats()
+{
+	m_pCtx = utp_init(2);
+	if (m_pCtx != NULL) {
+		utp_context_set_userdata(m_pCtx, this);
+		static const int s_aiCallbacks[] = {
+			UTP_SENDTO, UTP_ON_FIREWALL, UTP_ON_ACCEPT, UTP_ON_READ, UTP_ON_STATE_CHANGE, UTP_ON_ERROR
+			, UTP_GET_READ_BUFFER_SIZE, UTP_GET_UDP_MTU, UTP_GET_RANDOM
+		};
+		for (unsigned i = 0; i < _countof(s_aiCallbacks); ++i)
+			utp_set_callback(m_pCtx, s_aiCallbacks[i], &CPunchCallbacks::OnUtp);
+	}
+	LoadBenchPeers();
+}
+
+CPunchTransport::~CPunchTransport()
+{
+	m_cs.Lock();
+	for (std::list<SPunchSession*>::const_iterator it = m_listSessions.begin(); it != m_listSessions.end(); ++it)
+		if ((*it)->pLayer != NULL) {
+			(*it)->pLayer->Orphan();
+			(*it)->pLayer = NULL;
+		}
+	if (m_pCtx != NULL)
+		utp_destroy(m_pCtx);
+	m_pCtx = NULL;
+	while (!m_listSessions.empty()) {
+		delete m_listSessions.front();
+		m_listSessions.pop_front();
+	}
+	while (!m_listDead.empty()) {
+		delete m_listDead.front().first;
+		m_listDead.pop_front();
+	}
+	m_cs.Unlock();
+}
+
+// Until the rendez-vous exists (89nf), uTP is used only with the peers named by hand in
+// preferences.ini, [eMule] PunchBenchPeers=<IP>:<UDP port>[,<IP>:<UDP port>...]: an outgoing
+// connection to one of those IPs goes over uTP to that port, and only those IPs get past the gate.
+void CPunchTransport::LoadBenchPeers()
+{
+	TCHAR szPeers[1024];
+	::GetPrivateProfileString(_T("eMule"), _T("PunchBenchPeers"), _T(""), szPeers, _countof(szPeers), thePrefs.GetConfigFile());
+	CString strPeers(szPeers);
+	for (int iPos = 0; iPos >= 0;) {
+		CString strPeer(strPeers.Tokenize(_T(",; "), iPos));
+		if (strPeer.IsEmpty())
+			continue;
+		int iColon = strPeer.Find(_T(':'));
+		if (iColon <= 0)
+			continue;
+		const uint32 dwIP = inet_addr(CStringA(strPeer.Left(iColon)));
+		const int iPort = _tstoi(strPeer.Mid(iColon + 1));
+		if (dwIP != INADDR_NONE && dwIP != 0 && iPort > 0 && iPort <= 0xFFFF)
+			m_mapAllowed[dwIP] = (uint16)iPort;
+	}
+}
+
+bool CPunchTransport::IsAllowed(uint32 dwIP) const
+{
+	return m_mapAllowed.find(dwIP) != m_mapAllowed.end();
+}
+
+bool CPunchTransport::AttachOutgoing(CClientReqSocket *pSocket, uint32 dwIP)
+{
+	const std::map<uint32, uint16>::const_iterator it = m_mapAllowed.find(dwIP);
+	if (m_pCtx == NULL || it == m_mapAllowed.end())
+		return false;
+	pSocket->AttachPunchLayer(new CPunchSocketLayer(dwIP, it->second));
+	return true;
+}
+
+// Straight to the socket: the stream above was already paced by the upload throttler, and
+// uTP keeps its own congestion control. A datagram the socket cannot take now is dropped;
+// uTP sends it again.
+void CPunchTransport::SendRaw(uint32 dwIP, uint16 nPort, BYTE byType, const BYTE *pData, size_t nLen)
+{
+	BYTE abyPacket[2 + 1500];
+	if (nLen > sizeof abyPacket - 2 || theApp.clientudp == NULL || theApp.clientudp->m_hSocket == INVALID_SOCKET) {
+		++m_stats.uSendFailed;
+		return;
+	}
+	abyPacket[0] = OP_UDPRESERVEDPROT1;
+	abyPacket[1] = byType;
+	if (nLen > 0)
+		memcpy(&abyPacket[2], pData, nLen);
+	const sockaddr_in sa(SockAddr(dwIP, nPort));
+	if (::sendto(theApp.clientudp->m_hSocket, reinterpret_cast<const char*>(abyPacket), (int)(2 + nLen), 0, reinterpret_cast<const sockaddr*>(&sa), (int)sizeof sa) == SOCKET_ERROR)
+		++m_stats.uSendFailed;
+}
+
+void CPunchTransport::ProcessPacket(const BYTE *pPacket, int nLen, uint32 dwIP, uint16 nPort)
+{
+	if (nLen < 2) {
+		++m_stats.uDroppedShort;
+		return;
+	}
+	// libutp parses nothing that did not come from a peer let in
+	if (m_pCtx == NULL || !IsAllowed(dwIP)) {
+		++m_stats.uDroppedGate;
+		return;
+	}
+
+	m_cs.Lock();
+	switch (pPacket[1]) {
+	case PUNCHPKT_UTP:
+		{
+			const sockaddr_in sa(SockAddr(dwIP, nPort));
+			++m_stats.uPacketsIn;
+			utp_process_udp(m_pCtx, pPacket + 2, (size_t)(nLen - 2), reinterpret_cast<const sockaddr*>(&sa), (socklen_t)sizeof sa);
+			utp_issue_deferred_acks(m_pCtx);
+		}
+		break;
+	case PUNCHPKT_KEEPALIVE:
+		++m_stats.uKeepalivesIn;
+		break;
+	default:
+		++m_stats.uDroppedUnknown;
+	}
+	RaiseEvents();
+	m_cs.Unlock();
+}
+
+// main thread, every 100 ms
+void CPunchTransport::Process()
+{
+	if (m_pCtx == NULL)
+		return;
+	m_cs.Lock();
+	utp_check_timeouts(m_pCtx); // does its work every 500 ms
+	const DWORD dwNow = ::GetTickCount();
+	for (std::list<SPunchSession*>::const_iterator it = m_listSessions.begin(); it != m_listSessions.end(); ++it) {
+		SPunchSession &session = **it;
+		if (session.pUtp != NULL && dwNow >= session.dwLastSent + PUNCH_KEEPALIVE) {
+			SendRaw(session.dwIP, session.nPort, PUNCHPKT_KEEPALIVE, NULL, 0);
+			++m_stats.uKeepalivesOut;
+			session.dwLastSent = dwNow;
+		}
+	}
+	while (!m_listDead.empty() && dwNow >= m_listDead.front().second + PUNCH_DEAD_DELAY) {
+		delete m_listDead.front().first;
+		m_listDead.pop_front();
+	}
+	RaiseEvents();
+	m_cs.Unlock();
+}
+
+// main thread, m_cs held
+void CPunchTransport::RaiseEvents()
+{
+	for (std::list<SPunchSession*>::const_iterator it = m_listSessions.begin(); it != m_listSessions.end(); ++it) {
+		SPunchSession &session = **it;
+		if (session.lPendingEvents == 0)
+			continue;
+		const long lEvents = session.lPendingEvents;
+		session.lPendingEvents = 0;
+		if (session.pLayer == NULL)
+			continue;
+		if (lEvents & FD_CONNECT)
+			session.pLayer->RaiseEvent(FD_CONNECT, session.bConnected ? 0 : session.nPendingError);
+		if ((lEvents & FD_READ) && !session.bReadPosted) {
+			session.bReadPosted = true;
+			session.pLayer->RaiseEvent(FD_READ, 0);
+		}
+		if (lEvents & FD_WRITE)
+			session.pLayer->RaiseEvent(FD_WRITE, 0);
+		if ((lEvents & FD_CLOSE) && !session.bClosePosted) {
+			if (session.rx.size() > session.nRxRead)
+				session.lPendingEvents |= FD_CLOSE; // what arrived before the end is read first
+			else {
+				session.bClosePosted = true;
+				session.pLayer->RaiseEvent(FD_CLOSE, session.bEof ? 0 : session.nPendingError);
+			}
+		}
+	}
+}
+
+SPunchSession* CPunchTransport::NewSession(UTPSocket *pUtp, uint32 dwIP, uint16 nPort, bool bIncoming)
+{
+	SPunchSession *pSession = new SPunchSession();
+	pSession->pUtp = pUtp;
+	pSession->dwIP = dwIP;
+	pSession->nPort = nPort;
+	pSession->bIncoming = bIncoming;
+	pSession->dwStarted = pSession->dwLastSent = pSession->dwLastRecv = ::GetTickCount();
+	utp_set_userdata(pUtp, pSession);
+	m_listSessions.push_back(pSession);
+	return pSession;
+}
+
+// The upload throttler may still hold the pointer for the length of one Write(): freed later
+void CPunchTransport::DeleteSession(SPunchSession *pSession)
+{
+	m_listSessions.remove(pSession);
+	m_listDead.push_back(std::make_pair(pSession, ::GetTickCount()));
+	++m_stats.uClosed;
+}
+
+SPunchSession* CPunchTransport::Connect(CPunchSocketLayer *pLayer, uint32 dwIP, uint16 nPort)
+{
+	if (m_pCtx == NULL)
+		return NULL;
+	m_cs.Lock();
+	SPunchSession *pSession = NULL;
+	if (m_listSessions.size() < PUNCH_MAX_SESSIONS) {
+		UTPSocket *pUtp = utp_create_socket(m_pCtx);
+		if (pUtp != NULL) {
+			pSession = NewSession(pUtp, dwIP, nPort, false);
+			pSession->pLayer = pLayer;
+			const sockaddr_in sa(SockAddr(dwIP, nPort));
+			utp_connect(pUtp, reinterpret_cast<const sockaddr*>(&sa), (socklen_t)sizeof sa);
+			++m_stats.uConnects;
+		}
+	}
+	m_cs.Unlock();
+	return pSession;
+}
+
+int CPunchTransport::Write(SPunchSession *pSession, const void *pBuf, int nLen)
+{
+	m_cs.Lock();
+	if (pSession->pUtp == NULL || pSession->pLayer == NULL || !pSession->bConnected) {
+		m_cs.Unlock();
+		WSASetLastError(WSAENOTCONN);
+		return SOCKET_ERROR;
+	}
+	const ssize_t nWritten = utp_write(pSession->pUtp, const_cast<void*>(pBuf), (size_t)nLen);
+	if (nWritten <= 0) {
+		pSession->bWantWrite = true;
+		m_cs.Unlock();
+		WSASetLastError(WSAEWOULDBLOCK);
+		return SOCKET_ERROR;
+	}
+	pSession->nBytesOut += (uint64)nWritten;
+	m_cs.Unlock();
+	return (int)nWritten;
+}
+
+int CPunchTransport::Read(SPunchSession *pSession, void *pBuf, int nLen)
+{
+	m_cs.Lock();
+	pSession->bReadPosted = false;
+	const size_t nAvail = pSession->rx.size() - pSession->nRxRead;
+	if (nAvail == 0 || nLen <= 0) {
+		const bool bEnd = pSession->bEof || pSession->pUtp == NULL;
+		RaiseEvents();
+		m_cs.Unlock();
+		if (bEnd)
+			return 0;
+		WSASetLastError(WSAEWOULDBLOCK);
+		return SOCKET_ERROR;
+	}
+	const size_t nRead = (std::min)(nAvail, (size_t)nLen);
+	memcpy(pBuf, &pSession->rx[pSession->nRxRead], nRead);
+	pSession->nRxRead += nRead;
+	if (pSession->nRxRead == pSession->rx.size()) {
+		pSession->rx.clear();
+		pSession->nRxRead = 0;
+	} else {
+		if (pSession->nRxRead >= 64 * 1024) {
+			pSession->rx.erase(pSession->rx.begin(), pSession->rx.begin() + (ptrdiff_t)pSession->nRxRead);
+			pSession->nRxRead = 0;
+		}
+		pSession->lPendingEvents |= FD_READ;
+	}
+	if (pSession->pUtp != NULL)
+		utp_read_drained(pSession->pUtp); // the receive window may open again
+	RaiseEvents();
+	m_cs.Unlock();
+	return (int)nRead;
+}
+
+// main thread: the layer goes away
+void CPunchTransport::Detach(SPunchSession *pSession)
+{
+	m_cs.Lock();
+	pSession->pLayer = NULL;
+	if (pSession->pUtp != NULL)
+		utp_close(pSession->pUtp); // UTP_STATE_DESTROYING deletes the session, maybe at once
+	else
+		DeleteSession(pSession);
+	m_cs.Unlock();
+}
+
+///////////////////////////////////////////////////////////////////////////////
+// CPunchSocketLayer
+
+CPunchSocketLayer::CPunchSocketLayer(uint32 dwIP, uint16 nPort)
+	: m_pSession()
+	, m_dwIP(dwIP)
+	, m_nPort(nPort)
+{
+}
+
+CPunchSocketLayer::~CPunchSocketLayer()
+{
+	if (m_pSession != NULL && theApp.punchtransport != NULL)
+		theApp.punchtransport->Detach(m_pSession);
+}
+
+// incoming connection: the socket starts as an accepted one, and the first event makes it connected
+void CPunchSocketLayer::Accepted(SPunchSession *pSession)
+{
+	m_pSession = pSession;
+	pSession->pLayer = this;
+	SetLayerState(connected);
+	SetOwnerSocketState(attached);
+	TriggerEvent(FD_WRITE, 0, TRUE);
+}
+
+void CPunchSocketLayer::RaiseEvent(long lEvent, int nErrorCode)
+{
+	if (lEvent == FD_CONNECT) {
+		if (nErrorCode == 0)
+			SetLayerState(connected);
+		TriggerEvent(FD_CONNECT, nErrorCode, TRUE);
+		if (nErrorCode == 0)
+			TriggerEvent(FD_WRITE, 0, TRUE);
+	} else
+		TriggerEvent(lEvent, nErrorCode, TRUE);
+}
+
+void CPunchSocketLayer::OnAccept(int)
+{
+}
+
+void CPunchSocketLayer::OnClose(int)
+{
+}
+
+void CPunchSocketLayer::OnConnect(int)
+{
+}
+
+void CPunchSocketLayer::OnReceive(int)
+{
+}
+
+void CPunchSocketLayer::OnSend(int)
+{
+}
+
+void CPunchSocketLayer::Close()
+{
+	if (m_pSession != NULL && theApp.punchtransport != NULL)
+		theApp.punchtransport->Detach(m_pSession);
+	m_pSession = NULL;
+	CloseNext();
+}
+
+// The address is the one of the TCP port; uTP goes to the UDP port this layer was made for
+BOOL CPunchSocketLayer::Connect(const LPSOCKADDR, int)
+{
+	m_pSession = theApp.punchtransport->Connect(this, m_dwIP, m_nPort);
+	if (m_pSession == NULL) {
+		WSASetLastError(WSAECONNREFUSED);
+		return FALSE;
+	}
+	SetLayerState(connecting);
+	WSASetLastError(WSAEWOULDBLOCK);
+	return FALSE;
+}
+
+bool CPunchSocketLayer::Connect(const CString&, UINT)
+{
+	return Connect(NULL, 0) != FALSE;
+}
+
+BOOL CPunchSocketLayer::GetPeerName(CString &rPeerAddress, UINT &rPeerPort)
+{
+	rPeerAddress = ipstr(m_dwIP);
+	rPeerPort = m_nPort;
+	return TRUE;
+}
+
+BOOL CPunchSocketLayer::GetPeerName(LPSOCKADDR lpPeerAddr, int *lpPeerAddrLen)
+{
+	if (lpPeerAddr == NULL || lpPeerAddrLen == NULL || *lpPeerAddrLen < (int)sizeof(sockaddr_in)) {
+		WSASetLastError(WSAEFAULT);
+		return FALSE;
+	}
+	*reinterpret_cast<sockaddr_in*>(lpPeerAddr) = SockAddr(m_dwIP, m_nPort);
+	*lpPeerAddrLen = (int)sizeof(sockaddr_in);
+	return TRUE;
+}
+
+int CPunchSocketLayer::Receive(void *lpBuf, int nBufLen, int)
+{
+	if (m_pSession == NULL) {
+		WSASetLastError(WSAENOTCONN);
+		return SOCKET_ERROR;
+	}
+	return theApp.punchtransport->Read(m_pSession, lpBuf, nBufLen);
+}
+
+int CPunchSocketLayer::Send(const void *lpBuf, int nBufLen, int)
+{
+	SPunchSession *pSession = m_pSession;
+	if (pSession == NULL) {
+		WSASetLastError(WSAENOTCONN);
+		return SOCKET_ERROR;
+	}
+	return theApp.punchtransport->Write(pSession, lpBuf, nBufLen);
+}
+
+BOOL CPunchSocketLayer::ShutDown(int)
+{
+	return TRUE;
+}
