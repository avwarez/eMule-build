+//UPDIAG: the collectability probe. A pending send whose completion the operating system already
+//holds is collectable this instant, and nothing in the program is looking for that state: the
+//only collector sits behind the very flag that stays raised while it lasts. WSAGetOverlappedResult
+//is asked not to wait and nothing is cleaned up, so a build carrying this patch still behaves
+//exactly like one without it. The episode is reported once when it begins, with the two conditions
+//that would have kept the collector away from this socket, and once when it ends.
+DWORD CEMSocket::DbgProbeUncollectedSend(bool bInWindow, bool bHasQueues)
+{
+	if (!m_bUseOverlappedSend)
+		return 0;
+	CSingleLock lockSend(&sendLocker, TRUE);
+	if (!m_bPendingSendOv) {
+		m_dwDiagOvReadySince = 0;
+		return 0;
+	}
+	DWORD dwTransferred = 0, dwFlags = 0;
+	if (!::WSAGetOverlappedResult(GetSocketHandle(), &m_PendingSendOperation, &dwTransferred, FALSE, &dwFlags)) {
+		if (::WSAGetLastError() == WSA_IO_INCOMPLETE)
+			m_dwDiagOvReadySince = 0;	//still with the network, which is the ordinary case
+		return 0;
+	}
+	const DWORD dwNow = ::GetTickCount();
+	if (m_dwDiagOvReadySince != 0)
+		return max(dwNow - m_dwDiagOvReadySince, 1ul);
+
+	extern volatile LONG g_nDiagOvStuckBegun, g_nDiagOvStuckOpen; //defined in UploadBandwidthThrottler.cpp
+	m_dwDiagOvReadySince = dwNow;
+	::InterlockedIncrement(&g_nDiagOvStuckBegun);
+	::InterlockedIncrement(&g_nDiagOvStuckOpen);
+	theApp.QueueDebugLogLineEx(LOG_WARNING
+		, _T("UPDIAG|ovstuck begin inwindow=%d hasqueues=%d ovbytes=%u ovdone=%u ovage=%ums client: %s")
+		, (int)bInWindow, (int)bHasQueues, m_nDiagSendOvBytes, dwTransferred
+		, GetSendBlockedAge(), (LPCTSTR)DbgGetPeerInfo());
+	return 1;
+}
+
+//UPDIAG: the other end of the episode. Which path did the collecting is not asked here, because
+//the answer that matters is readable from the state instead: the only collector a build without
+//a correction has is reached through the socket's own queues, so an episode that ends with
+//nothing queued can only have been ended by something that stopped asking that question.
+void CEMSocket::DbgNoteUncollectedEnd(bool bCancelled)
+{
+	if (m_dwDiagOvReadySince == 0)
+		return;
+	extern volatile LONG g_nDiagOvStuckOpen, g_nDiagOvStuckEnded, g_nDiagOvStuckNoQueues
+		, g_nDiagOvStuckMaxMs, g_nDiagOvStuckTotalMs; //defined in UploadBandwidthThrottler.cpp
+	const DWORD dwLasted = max(::GetTickCount() - m_dwDiagOvReadySince, 1ul);
+	const bool bHadQueues = HasQueues();
+	m_dwDiagOvReadySince = 0;
+	::InterlockedDecrement(&g_nDiagOvStuckOpen);
+	::InterlockedIncrement(&g_nDiagOvStuckEnded);
+	if (!bHadQueues)
+		::InterlockedIncrement(&g_nDiagOvStuckNoQueues);
+	::InterlockedExchangeAdd(&g_nDiagOvStuckTotalMs, (LONG)dwLasted);
+	for (LONG lOld = g_nDiagOvStuckMaxMs; (LONG)dwLasted > lOld;) {
+		const LONG lPrev = ::InterlockedCompareExchange(&g_nDiagOvStuckMaxMs, (LONG)dwLasted, lOld);
+		if (lPrev == lOld)
+			break;
+		lOld = lPrev;
+	}
+	theApp.QueueDebugLogLineEx(LOG_WARNING
+		, _T("UPDIAG|ovstuck end after %ums, %s, hasqueues=%d ovbytes=%u client: %s")
+		, dwLasted, bCancelled ? _T("cancelled") : _T("collected"), (int)bHadQueues
+		, m_nDiagSendOvBytes, (LPCTSTR)DbgGetPeerInfo());
+}
