+// A check of the public endpoint, natd QuickCheck on the STUN servers: one at a time, and none
+// within a minute of the last one, whose result stands.
+void CNatTraversal::Impl::CheckEndpoint(bool bClose, natd::TimePoint now)
+{
+	if (!bProfileReady)
+		return;
+	bCloseIfChanged = bCloseIfChanged || bClose;
+	if (pCheck || (bCheckedOnce && ::GetTickCount() - dwLastCheck < NATD_CHECK_REUSE)) {
+		if (!pCheck)
+			bCloseIfChanged = false;	// the endpoint was found the same, or updated, a moment ago
+		return;
+	}
+	pCheck = std::make_unique<natd::QuickCheck>(discoveryConfig, profile, io);
+	pCheck->start(now);
+}
+
+void CNatTraversal::Impl::PollCheck(natd::TimePoint now)
+{
+	if (!pCheck)
+		return;
+	pCheck->poll(now);
+	const natd::QuickCheckResult result = pCheck->result();
+	if (result == natd::QuickCheckResult::Pending)
+		return;
+	const bool bChanged = result == natd::QuickCheckResult::Changed;
+	if (bChanged) {
+		const natd::Endpoint observed(pCheck->observed());
+		if (thePrefs.GetVerbose())
+			AddDebugLogLine(false, _T("NAT traversal: public endpoint changed from %s to %s"), (LPCTSTR)EndpointStr(profile.publicEndpoint), (LPCTSTR)EndpointStr(observed));
+		profile.publicEndpoint = observed;
+		// the streams cannot outlive the address: they end as the TCP connections of a
+		// client whose address changed
+		if (bCloseIfChanged)
+			for (std::map<uint32, std::unique_ptr<SSession>>::const_iterator it = sessions.begin(); it != sessions.end(); ++it)
+				if (it->second->pStream && !it->second->bOver)
+					Failed(*it->second, WSAECONNRESET);
+	}
+	pCheck.reset();
+	dwLastCheck = ::GetTickCount();
+	bCheckedOnce = true;
+	bCloseIfChanged = false;
+}
