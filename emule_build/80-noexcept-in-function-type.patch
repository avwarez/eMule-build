-void Sort(CStringArray &astr, int(__cdecl *pfnCompare)(const void*, const void*) noexcept)
+// Since C++17 noexcept is part of a function type, so the noexcept-qualified
+// parameter these two used to carry no longer matched their declarations in
+// OtherFunctions.h, which never had it. Dropping qsort settles that at the root:
+// std::sort takes a typed callable, so no function pointer crosses an extern "C"
+// boundary (this is also what warning C5039 was about), the element size comes
+// from the element type instead of the hand-written sizeof(CString*) - the
+// elements are CString objects, and that only ever worked because
+// sizeof(CString) == sizeof(void*) - and the elements are moved through their own
+// operators rather than copied bytewise, which is not something qsort may do to a
+// reference-counted type.
+void Sort(CStringArray &astr, int(__cdecl *pfnCompare)(const void*, const void*))
 {
-	qsort(astr.GetData(), astr.GetCount(), sizeof(CString*), pfnCompare);
+	CString *const pFirst = astr.GetData();
+	std::sort(pFirst, pFirst + astr.GetCount()
+		, [pfnCompare](const CString &rstr1, const CString &rstr2) { return pfnCompare(&rstr1, &rstr2) < 0; });
 }
 
