diff --git a/srchybrid/EMSocket.cpp b/srchybrid/EMSocket.cpp
index 8d73530..a4aa3c5 100644
--- a/srchybrid/EMSocket.cpp
+++ b/srchybrid/EMSocket.cpp
@@ -91,6 +91,7 @@ namespace
 		WSAOVERLAPPED *pOverlapped;
 		CArray<WSABUF> aBuffer;
 		DWORD dwEnded; // when the send was first seen ended, 0 before
+		DWORD dwDiagAbandoned; // 99c: when its socket let go of it
 	};
 
 	CCriticalSection s_lockAbandonedSends;
@@ -115,6 +116,9 @@ void CEMSocket::FreeFinishedAbandonedSends()
 		}
 		if (dwNow - pAbandoned->dwEnded < SEC2MS(1))
 			continue;
+		// 99c
+		theApp.QueueDebugLogLineEx(LOG_WARNING, _T("Socket send: a send left behind by its socket ended within %lu ms, status 0x%08lx - its memory is freed now")
+			, pAbandoned->dwEnded - pAbandoned->dwDiagAbandoned, (DWORD)pAbandoned->pOverlapped->Internal);
 		for (INT_PTR i = pAbandoned->aBuffer.GetCount(); --i >= 0;)
 			delete[] pAbandoned->aBuffer[i].buf;
 		delete pAbandoned->pOverlapped;
@@ -139,6 +143,7 @@ CEMSocket::CEMSocket()
 	, m_sendblen()
 	, m_sent()
 	, m_pPendingSendOperation(new WSAOVERLAPPED())
+	, m_dwDiagSendThread()
 	, m_numberOfSentBytesCompleteFile()
 	, m_numberOfSentBytesPartFile()
 	//, m_numberOfSentBytesControlPacket()
@@ -852,6 +857,7 @@ SocketSentBytes CEMSocket::SendOv(uint32 maxNumberOfBytesToSend, uint32 minFragS
 				// all right, prepare to send our collected buffers
 				memset(m_pPendingSendOperation, 0, sizeof WSAOVERLAPPED);
 				m_pPendingSendOperation->hEvent = theApp.uploadBandwidthThrottler->GetSocketAvailableEvent();
+				m_dwDiagSendThread = ::GetCurrentThreadId(); // 99c
 				m_bPendingSendOv = true;
 				if (CEncryptedStreamSocket::SendOv(m_aBufferSend, m_pPendingSendOperation) == 0)
 					CleanUpOverlappedSendOperation(false);
@@ -1196,6 +1202,14 @@ void CEMSocket::CleanUpOverlappedSendOperation(bool bCancel)
 			pAbandoned->pOverlapped = m_pPendingSendOperation;
 			pAbandoned->aBuffer.Copy(m_aBufferSend);
 			pAbandoned->dwEnded = 0;
+			// 99c: before 97o its memory was freed here and its end wrote into whatever took its place
+			pAbandoned->dwDiagAbandoned = ::GetTickCount();
+			ULONGLONG uDiagBytes = 0;
+			for (INT_PTR i = m_aBufferSend.GetCount(); --i >= 0;)
+				uDiagBytes += m_aBufferSend[i].len;
+			theApp.QueueDebugLogLineEx(LOG_WARNING, _T("Socket send: a send of %I64u bytes is still in progress when %s lets go of it (started by thread %lu, cancelled from thread %lu) - kept until it ends")
+				, uDiagBytes, byConnected == EMS_DISCONNECTED ? _T("the socket teardown") : _T("the send error handling")
+				, m_dwDiagSendThread, ::GetCurrentThreadId());
 			m_aBufferSend.RemoveAll();
 			m_pPendingSendOperation = new WSAOVERLAPPED();
 			CSingleLock lockAbandoned(&s_lockAbandonedSends, TRUE);
diff --git a/srchybrid/EMSocket.h b/srchybrid/EMSocket.h
index bb97efe..1dc68a3 100644
--- a/srchybrid/EMSocket.h
+++ b/srchybrid/EMSocket.h
@@ -128,6 +128,7 @@ private:
 	uint32	m_sendblen; //packet length in sendbuffer
 	uint32	m_sent;
 	WSAOVERLAPPED *m_pPendingSendOperation; // 97o: on the heap, so that a send still in flight can keep it after the socket is gone
+	DWORD	m_dwDiagSendThread; // 99c: thread that started the pending send
 	CArray<WSABUF> m_aBufferSend;
 
 	CTypedPtrList<CPtrList, Packet*> controlpacket_queue;	//use sendLocker!
