diff --git a/srchybrid/UploadQueue.cpp b/srchybrid/UploadQueue.cpp
index d2bac2b..1dc27be 100644
--- a/srchybrid/UploadQueue.cpp
+++ b/srchybrid/UploadQueue.cpp
@@ -55,6 +55,14 @@ volatile LONG g_nDiagShortSends = 0;
 volatile LONG g_nDiagShortSendBytes = 0;
 volatile LONG g_nDiagSendsChecked = 0;
 
+// UPDIAG: the heartbeat of the GUI timer. Everything periodic in eMule hangs off UploadTimer
+// below, including the one call that drains the queued debug log, so when that timer stops
+// being delivered the program keeps working and the log simply stops - and starts again later
+// with the backlog written under the wrong timestamps. The throttler runs on its own thread and
+// can see it happen; these two let it say so, with a duration it measures itself.
+volatile LONG g_nDiagGuiTicks = 0;		// UploadTimer entries
+volatile LONG g_dwDiagGuiLastTick = 0;	// tick count of the last one
+
 #ifdef _DEBUG
 #define new DEBUG_NEW
 #undef THIS_FILE
@@ -997,6 +1005,11 @@ VOID CALLBACK CUploadQueue::UploadTimer(HWND /*hwnd*/, UINT /*uMsg*/, UINT_PTR /
 		if (theApp.IsClosing())
 			return;
 
+		//UPDIAG: proof of life for this timer, read from the throttler thread. Written before the
+		//drain below, so a tick counted is a tick that reached the drain.
+		::InterlockedIncrement(&g_nDiagGuiTicks);
+		::InterlockedExchange(&g_dwDiagGuiLastTick, (LONG)::GetTickCount());
+
 		// Elandal:ThreadSafeLogging -->
 		// other threads may have queued up log lines. This prints them.
 		theApp.HandleDebugLogQueue();
