+//UPDIAG: the backlog itself. It only grows while the drain above is not being called, so it
+//measures the stall directly rather than by the density of what comes out at the end of one.
+INT_PTR CemuleApp::DbgGetDebugLogQueueCount()
+{
+	m_queueLock.Lock();
+	const INT_PTR nCount = m_QueueDebugLog.GetCount();
+	m_queueLock.Unlock();
+	return nCount;
+}
+
 void CemuleApp::HandleLogQueue()
 {
 	m_queueLock.Lock();
