+// 99b-diag-timeout (temporary) -------------------------------------------------------------
+// Lines "UPDIAG|timeout <event>:" in the verbose log, to see what 97w changed in CheckTimeOut()
+// and what the client sockets that time out were doing:
+//   ahead  timeout_timer was ahead of the tick by "by" ms (the upload throttler reset it
+//          meanwhile): 97t closed the socket here as timed out, 97w counts it as no idle time.
+//          Logged the first time on each socket; n= counts them on the socket, all= in eMule.
+//   fire   a socket timed out: idle and limit in ms, ext = the extension of the limit (buddy,
+//          upstart = the first minutes of an upload slot, chat, half = still connecting, none),
+//          send = ms since the throttler last asked it to send, busy = its send buffer is full,
+//          queued = it still has packets to send, ahead = the times its timer was found ahead,
+//          then the upload and download state, the slot's age and what it carried.
+
+static UINT s_uDiagAheadAll = 0;
+
+void CClientReqSocket::DiagTimeoutAhead(LONG lIdle, DWORD uTimeout)
+{
+	++s_uDiagAheadAll;
+	if (m_uDiagAhead++ > 0 || !thePrefs.GetVerbose())
+		return;
+	AddDebugLogLine(false, _T("UPDIAG|timeout ahead: by=%ldms base=%lums state=%u n=%u all=%u us=%s Client: %s")
+		, -lIdle, uTimeout, m_nOnConnect, m_uDiagAhead, s_uDiagAheadAll
+		, client ? client->DbgGetUploadState() : _T("-"), (LPCTSTR)DbgGetClientInfo());
+}
+
+void CClientReqSocket::DiagTimeoutFire(LONG lIdle, DWORD uTimeout)
+{
+	if (!thePrefs.GetVerbose())
+		return;
+	LPCTSTR pszExt;
+	const DWORD uExt = uTimeout - GetTimeOut();
+	if (m_nOnConnect == SS_Half)
+		pszExt = _T("half");
+	else if (uExt == MIN2MS(15))
+		pszExt = _T("buddy");
+	else if (uExt == 4 * CONNECTION_TIMEOUT)
+		pszExt = _T("upstart");
+	else if (uExt == CONNECTION_TIMEOUT)
+		pszExt = _T("chat");
+	else
+		pszExt = _T("none");
+	const LONG lSend = (LONG)(timeGetTime() - GetLastCalledSend());
+	const bool bUploading = client != NULL && client->GetUploadState() == US_UPLOADING;
+	AddDebugLogLine(false, _T("UPDIAG|timeout fire: idle=%ldms limit=%lums ext=%s send=%ldms busy=%u queued=%u ahead=%u us=%s ds=%s slot=%us up=%I64u Client: %s")
+		, lIdle, uTimeout, pszExt, lSend, IsBusyQuickCheck() ? 1u : 0u, HasQueues() ? 1u : 0u, m_uDiagAhead
+		, client ? client->DbgGetUploadState() : _T("-"), client ? client->DbgGetDownloadState() : _T("-")
+		, bUploading ? client->GetUpStartTimeDelay() / SEC2MS(1) : 0u, client ? client->GetSessionUp() : 0ui64
+		, (LPCTSTR)DbgGetClientInfo());
+}
