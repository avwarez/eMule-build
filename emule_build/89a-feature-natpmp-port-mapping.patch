+#include "StdAfx.h"
+#include <memory>
+#include <iphlpapi.h>
+#include "preferences.h"
+#include "UPnPImplNatPmp.h"
+#include "Log.h"
+#include "Otherfunctions.h"
+#define ENABLE_STRNATPMPERR
+#include "libnatpmp\natpmp.h"
+#include "opcodes.h"
+
+#ifdef _DEBUG
+#define new DEBUG_NEW
+#undef THIS_FILE
+static char THIS_FILE[] = __FILE__;
+#endif
+
+static LPCTSTR const sTCP = _T("TCP");
+static LPCTSTR const sUDP = _T("UDP");
+
+static const uint32 NATPMP_LIFETIME = 7200;			// seconds asked for each mapping (RFC 6886 3.3)
+static const uint32 NATPMP_MAX_RENEW_DELAY = 900;	// renewed at half the lease granted, but at least this often
+static const uint32 NATPMP_MIN_RENEW_DELAY = 60;
+static const uint32 NATPMP_RETRY_DELAY = 60;		// after a failed renewal
+static const DWORD NATPMP_REQUEST_TIMEOUT = 2000;	// libnatpmp sends again after 250, 750 and 1750 ms
+static const DWORD NATPMP_UNMAP_TIMEOUT = 750;
+static const DWORD NATPMP_WAIT_SLICE = 50;			// how often a wait for an answer looks at the stop event
+
+struct CUPnPImplNatPmp::SRequest
+{
+	natpmp_t np;
+	natpmpresp_t resp;
+	int nProtocol;		// NATPMP_PROTOCOL_TCP or NATPMP_PROTOCOL_UDP, 0 for the public address request
+	uint16 nPort;
+	uint16 nPublicPort;
+	uint32 nLifetime;
+	int nResult;
+	bool bOpen;
+};
+
+static CString NatPmpError(int nResult)
+{
+	if (nResult == NATPMP_TRYAGAIN)
+		return CString(_T("no answer"));
+	return CString(strnatpmperr(nResult));
+}
+
+CUPnPImplNatPmp::CUPnPImplNatPmp()
+	: m_pThread()
+	, m_hStopEvent(::CreateEvent(NULL, TRUE, FALSE, NULL))
+	, m_hRefreshEvent(::CreateEvent(NULL, FALSE, FALSE, NULL))
+	, m_nGateway()
+	, m_nLastEpoch()
+	, m_tLastEpoch()
+	, m_dwRenewDelay()
+	, m_bDiscovering()
+{
+}
+
+CUPnPImplNatPmp::~CUPnPImplNatPmp()
+{
+	StopThread();
+	if (m_hStopEvent != NULL)
+		VERIFY(::CloseHandle(m_hStopEvent));
+	if (m_hRefreshEvent != NULL)
+		VERIFY(::CloseHandle(m_hRefreshEvent));
+}
+
+bool CUPnPImplNatPmp::IsReady()
+{
+	// only the first mapping of the ports keeps this implementation busy: a renewal can be
+	// asked for at any time, and StartDiscovery() stops the thread that renews
+	return !m_bDiscovering;
+}
+
+void CUPnPImplNatPmp::StopAsyncFind()
+{
+	StopThread();
+}
+
+void CUPnPImplNatPmp::DeletePorts()
+{
+	StopThread();
+	if (ArePortsForwarded() == TRIS_TRUE && m_nGateway != 0)
+		UnmapPorts(m_nGateway, m_nTCPPort, m_nUDPPort, m_nTCPWebPort, false);
+	m_nUDPPort = 0;
+	m_nTCPPort = 0;
+	m_nTCPWebPort = 0;
+	m_nOldUDPPort = 0;
+	m_nOldTCPPort = 0;
+	m_nOldTCPWebPort = 0;
+	m_bUPnPPortsForwarded = TRIS_FALSE;
+}
+
+void CUPnPImplNatPmp::StartDiscovery(uint16 nTCPPort, uint16 nUDPPort, uint16 nTCPWebPort)
+{
+	DebugLog(_T("Using NAT-PMP based implementation"));
+	DebugLog(_T("libnatpmp (c) 2007-2022 Thomas Bernard - http://miniupnp.free.fr/libnatpmp.html"));
+	StopThread();
+	if (ArePortsForwarded() == TRIS_TRUE) {
+		m_nOldUDPPort = m_nUDPPort;
+		m_nOldTCPPort = m_nTCPPort;
+		m_nOldTCPWebPort = m_nTCPWebPort;
+	} else {
+		m_nOldUDPPort = 0;
+		m_nOldTCPPort = 0;
+		m_nOldTCPWebPort = 0;
+	}
+	m_nUDPPort = nUDPPort;
+	m_nTCPPort = nTCPPort;
+	m_nTCPWebPort = nTCPWebPort;
+	m_bUPnPPortsForwarded = TRIS_UNKNOWN;
+	m_bCheckAndRefresh = false;
+	StartThread();
+}
+
+bool CUPnPImplNatPmp::CheckAndRefresh()
+{
+	if (m_bDiscovering || m_pThread == NULL || ::WaitForSingleObject(m_pThread->m_hThread, 0) != WAIT_TIMEOUT) {
+		DebugLog(_T("Not refreshing NAT-PMP ports because they don't seem to be forwarded in the first place"));
+		return false;
+	}
+	DebugLog(_T("Checking and refreshing NAT-PMP ports"));
+	m_bCheckAndRefresh = true;
+	VERIFY(::SetEvent(m_hRefreshEvent));
+	return true;
+}
+
+void CUPnPImplNatPmp::StartThread()
+{
+	m_bDiscovering = true;
+	if (m_hStopEvent != NULL && m_hRefreshEvent != NULL)
+		m_pThread = AfxBeginThread(RunProc, this, THREAD_PRIORITY_NORMAL, 0, CREATE_SUSPENDED);
+	if (m_pThread == NULL) {
+		DebugLogError(_T("CUPnPImplNatPmp::StartThread, failed to create the NAT-PMP thread"));
+		m_bDiscovering = false;
+		m_bUPnPPortsForwarded = TRIS_FALSE;
+		SendResultMessage();
+		return;
+	}
+	// the object owns the thread object and its handle, so that StopThread() can wait on it
+	m_pThread->m_bAutoDelete = FALSE;
+	m_pThread->ResumeThread();
+}
+
+void CUPnPImplNatPmp::StopThread()
+{
+	if (m_pThread != NULL) {
+		// Every wait of the thread looks at the stop event at least every NATPMP_WAIT_SLICE ms,
+		// and it never waits on this thread, so this ends quickly. It is never terminated:
+		// a thread killed from outside can leave a lock taken for good.
+		VERIFY(::SetEvent(m_hStopEvent));
+		VERIFY(::WaitForSingleObject(m_pThread->m_hThread, INFINITE) == WAIT_OBJECT_0);
+		delete m_pThread;
+		m_pThread = NULL;
+	}
+	if (m_hStopEvent != NULL)
+		VERIFY(::ResetEvent(m_hStopEvent));
+	if (m_hRefreshEvent != NULL)
+		VERIFY(::ResetEvent(m_hRefreshEvent));
+	m_bDiscovering = false;
+}
+
+bool CUPnPImplNatPmp::ShouldStop() const
+{
+	return ::WaitForSingleObject(m_hStopEvent, 0) == WAIT_OBJECT_0;
+}
+
+UINT AFX_CDECL CUPnPImplNatPmp::RunProc(LPVOID pParam)
+{
+	DbgSetThreadName("CUPnPImplNatPmp");
+	InitThreadLocale();
+	static_cast<CUPnPImplNatPmp*>(pParam)->Run();
+	return 0;
+}
+
+void CUPnPImplNatPmp::Run()
+{
+	bool bSucceeded = RunStep(false);
+	m_bDiscovering = false;
+	if (ShouldStop())	// don't send the result on an abort request
+		return;
+	m_bUPnPPortsForwarded = bSucceeded ? TRIS_TRUE : TRIS_FALSE;
+	SendResultMessage();
+	if (!bSucceeded)
+		return;
+
+	// the mappings are leases: renew them until told to stop
+	m_bCheckAndRefresh = true;
+	const HANDLE ahEvents[2] = {m_hStopEvent, m_hRefreshEvent};
+	for (;;) {
+		DWORD dwWait = ::WaitForMultipleObjects(2, ahEvents, FALSE, m_dwRenewDelay);
+		if (dwWait != WAIT_OBJECT_0 + 1 && dwWait != WAIT_TIMEOUT)
+			break;
+		bSucceeded = RunStep(true);
+		if (ShouldStop())
+			break;
+		m_bUPnPPortsForwarded = bSucceeded ? TRIS_TRUE : TRIS_FALSE;
+		SendResultMessage();
+	}
+}
+
+bool CUPnPImplNatPmp::RunStep(bool bRenew)
+{
+#if !(defined(_DEBUG) || defined(_BETA) || defined(_DEVBUILD))
+	try {
+#endif
+		return bRenew ? Renew() : Discover();
+#if !(defined(_DEBUG) || defined(_BETA) || defined(_DEVBUILD))
+	} catch (...) {
+		DebugLogError(_T("Unknown Exception in CUPnPImplNatPmp::RunStep()"));
+	}
+	m_dwRenewDelay = SEC2MS(NATPMP_RETRY_DELAY);
+	return false;
+#endif
+}
+
+bool CUPnPImplNatPmp::Discover()
+{
+	uint32 nGateway;
+	if (!FindGateway(nGateway))
+		return false;
+
+	SRequest req = {};
+	Exchange(nGateway, &req, 1, NATPMP_REQUEST_TIMEOUT, true);
+	if (ShouldStop())
+		return false;
+	if (req.nResult != 0) {
+		DebugLog(_T("NAT-PMP: gateway %s does not answer (%s), aborting"), (LPCTSTR)ipstr(nGateway), (LPCTSTR)NatPmpError(req.nResult));
+		return false;
+	}
+	DebugLog(_T("NAT-PMP: gateway %s answered, public address %s"), (LPCTSTR)ipstr(nGateway), (LPCTSTR)ipstr(req.resp.pnu.publicaddress.addr.s_addr));
+	m_nGateway = nGateway;
+	m_tLastEpoch = 0;
+	CheckEpoch(req.resp.epoch);
+
+	// do we still have old mappings? Remove them first
+	if (m_nOldTCPPort != 0 || m_nOldUDPPort != 0 || m_nOldTCPWebPort != 0) {
+		UnmapPorts(nGateway, m_nOldTCPPort, m_nOldUDPPort, m_nOldTCPWebPort, true);
+		m_nOldTCPPort = 0;
+		m_nOldUDPPort = 0;
+		m_nOldTCPWebPort = 0;
+	}
+	return !ShouldStop() && MapPorts(nGateway);
+}
+
+bool CUPnPImplNatPmp::Renew()
+{
+	m_dwRenewDelay = SEC2MS(NATPMP_RETRY_DELAY);
+	uint32 nGateway;
+	if (!FindGateway(nGateway)) {
+		DebugLogWarning(_T("NAT-PMP: cannot renew the port mappings, trying again in %u seconds"), NATPMP_RETRY_DELAY);
+		return false;
+	}
+	if (nGateway != m_nGateway) {
+		DebugLog(_T("NAT-PMP: the gateway changed from %s to %s"), (LPCTSTR)ipstr(m_nGateway), (LPCTSTR)ipstr(nGateway));
+		m_nGateway = nGateway;
+		m_tLastEpoch = 0;
+	}
+	if (m_nOldTCPWebPort != 0) {	//unmap WebServer port (late binding)
+		UnmapPorts(nGateway, 0, 0, m_nOldTCPWebPort, true);
+		m_nOldTCPWebPort = 0;
+	}
+	return MapPorts(nGateway);
+}
+
+bool CUPnPImplNatPmp::MapPorts(uint32 nGateway)
+{
+	const uint16 nTCPPort = m_nTCPPort;
+	const uint16 nUDPPort = m_nUDPPort;
+	const uint16 nTCPWebPort = m_nTCPWebPort;
+	m_dwRenewDelay = SEC2MS(NATPMP_RETRY_DELAY);
+	if (nTCPPort == 0)
+		return false;
+
+	SRequest aReq[3] = {};
+	int nCount = 0;
+	aReq[nCount].nProtocol = NATPMP_PROTOCOL_TCP;
+	aReq[nCount++].nPort = nTCPPort;
+	if (nUDPPort != 0) {
+		aReq[nCount].nProtocol = NATPMP_PROTOCOL_UDP;
+		aReq[nCount++].nPort = nUDPPort;
+	}
+	if (nTCPWebPort != 0) {
+		aReq[nCount].nProtocol = NATPMP_PROTOCOL_TCP;
+		aReq[nCount++].nPort = nTCPWebPort;
+	}
+	for (int i = 0; i < nCount; ++i) {
+		aReq[i].nPublicPort = aReq[i].nPort;	// eMule announces its own ports: the public ones must be the same
+		aReq[i].nLifetime = NATPMP_LIFETIME;
+	}
+	Exchange(nGateway, aReq, nCount, NATPMP_REQUEST_TIMEOUT, true);
+	if (ShouldStop())
+		return false;
+
+	bool bSucceeded = true;
+	uint32 nLifetime = NATPMP_LIFETIME;
+	bool abGranted[3] = {};
+	bool abFailed[3] = {};
+	for (int i = 0; i < nCount; ++i) {
+		const SRequest &req = aReq[i];
+		LPCTSTR pszProt = (req.nProtocol == NATPMP_PROTOCOL_TCP) ? sTCP : sUDP;
+		const bool bWebPort = (nTCPWebPort != 0 && i == nCount - 1);	// don't fail if only the Web Interface port fails for some reason
+		if (req.nResult != 0) {
+			DebugLogWarning(_T("NAT-PMP: mapping port %hu (%s) failed: %s"), req.nPort, pszProt, (LPCTSTR)NatPmpError(req.nResult));
+			abFailed[i] = true;
+		} else {
+			abGranted[i] = true;
+			CheckEpoch(req.resp.epoch);
+			const uint16 nMappedPort = req.resp.pnu.newportmapping.mappedpublicport;
+			const uint32 nGranted = req.resp.pnu.newportmapping.lifetime;
+			if (nMappedPort != req.nPort) {
+				DebugLogWarning(_T("NAT-PMP: the gateway mapped port %hu (%s) to public port %hu - considering as failed"), req.nPort, pszProt, nMappedPort);
+				abFailed[i] = true;
+			} else if (nGranted == 0) {
+				DebugLogWarning(_T("NAT-PMP: the gateway granted port %hu (%s) for no time - considering as failed"), req.nPort, pszProt);
+				abFailed[i] = true;
+			} else {
+				DebugLog(_T("NAT-PMP: mapped port %hu (%s) for %u seconds"), req.nPort, pszProt, nGranted);
+				if (nGranted < nLifetime)
+					nLifetime = nGranted;
+			}
+		}
+		if (abFailed[i] && !bWebPort)
+			bSucceeded = false;
+	}
+
+	// take back whatever the gateway granted but cannot be used
+	SRequest aUnmap[3] = {};
+	int nUnmap = 0;
+	for (int i = 0; i < nCount; ++i)
+		if (abGranted[i] && (abFailed[i] || !bSucceeded)) {
+			aUnmap[nUnmap].nProtocol = aReq[i].nProtocol;
+			aUnmap[nUnmap++].nPort = aReq[i].nPort;
+		}
+	if (nUnmap > 0)
+		Unmap(nGateway, aUnmap, nUnmap, true);
+
+	if (bSucceeded) {
+		uint32 nDelay = nLifetime / 2;
+		if (nDelay > NATPMP_MAX_RENEW_DELAY)
+			nDelay = NATPMP_MAX_RENEW_DELAY;
+		else if (nDelay < NATPMP_MIN_RENEW_DELAY)
+			nDelay = NATPMP_MIN_RENEW_DELAY;
+		m_dwRenewDelay = SEC2MS(nDelay);
+	} else
+		DebugLogWarning(_T("NAT-PMP: port mapping failed, trying again in %u seconds"), NATPMP_RETRY_DELAY);
+	return bSucceeded;
+}
+
+void CUPnPImplNatPmp::UnmapPorts(uint32 nGateway, uint16 nTCPPort, uint16 nUDPPort, uint16 nTCPWebPort, bool bAbortable)
+{
+	SRequest aReq[3] = {};
+	int nCount = 0;
+	if (nTCPPort != 0) {
+		aReq[nCount].nProtocol = NATPMP_PROTOCOL_TCP;
+		aReq[nCount++].nPort = nTCPPort;
+	}
+	if (nUDPPort != 0) {
+		aReq[nCount].nProtocol = NATPMP_PROTOCOL_UDP;
+		aReq[nCount++].nPort = nUDPPort;
+	}
+	if (nTCPWebPort != 0) {
+		aReq[nCount].nProtocol = NATPMP_PROTOCOL_TCP;
+		aReq[nCount++].nPort = nTCPWebPort;
+	}
+	if (nCount > 0)
+		Unmap(nGateway, aReq, nCount, bAbortable);
+}
+
+void CUPnPImplNatPmp::Unmap(uint32 nGateway, SRequest *pRequests, int nCount, bool bAbortable)
+{
+	// a mapping asked for no time and no public port is a deletion (RFC 6886 3.4)
+	for (int i = 0; i < nCount; ++i) {
+		pRequests[i].nPublicPort = 0;
+		pRequests[i].nLifetime = 0;
+	}
+	Exchange(nGateway, pRequests, nCount, NATPMP_UNMAP_TIMEOUT, bAbortable);
+	for (int i = 0; i < nCount; ++i) {
+		LPCTSTR pszProt = (pRequests[i].nProtocol == NATPMP_PROTOCOL_TCP) ? sTCP : sUDP;
+		if (pRequests[i].nResult == 0)
+			DebugLog(_T("NAT-PMP: removed mapping for %s port %hu"), pszProt, pRequests[i].nPort);
+		else
+			DebugLogWarning(_T("NAT-PMP: failed to remove mapping for %s port %hu: %s"), pszProt, pRequests[i].nPort, (LPCTSTR)NatPmpError(pRequests[i].nResult));
+	}
+}
+
+void CUPnPImplNatPmp::Exchange(uint32 nGateway, SRequest *pRequests, int nCount, DWORD dwTimeout, bool bAbortable)
+{
+	// The requests go out together, each on a socket of its own, and the answers are waited
+	// for together, so that a round costs at most dwTimeout whatever the number of ports.
+	ASSERT(nCount > 0 && nCount <= 3);
+	for (int i = 0; i < nCount; ++i) {
+		SRequest &req = pRequests[i];
+		req.bOpen = false;
+		req.nResult = initnatpmp(&req.np, 1, nGateway);
+		if (req.nResult < 0) {
+			if (req.np.s >= 0)
+				closenatpmp(&req.np);
+			continue;
+		}
+		req.bOpen = true;
+		int nSent = (req.nProtocol != 0)
+			? sendnewportmappingrequest(&req.np, req.nProtocol, req.nPort, req.nPublicPort, req.nLifetime)
+			: sendpublicaddressrequest(&req.np);
+		req.nResult = (nSent < 0) ? nSent : NATPMP_TRYAGAIN;
+	}
+
+	const ULONGLONG tDeadline = ::GetTickCount64() + dwTimeout;
+	for (;;) {
+		fd_set fds;
+		fds.fd_count = 0;
+		for (int i = 0; i < nCount; ++i) {
+			SRequest &req = pRequests[i];
+			if (req.nResult == NATPMP_TRYAGAIN) {
+				// reads the answer if there is one, and sends the request again when it is due
+				req.nResult = readnatpmpresponseorretry(&req.np, &req.resp);
+				if (req.nResult == NATPMP_TRYAGAIN)
+					fds.fd_array[fds.fd_count++] = static_cast<SOCKET>(req.np.s);
+			}
+		}
+		if (fds.fd_count == 0 || (bAbortable && ShouldStop()))
+			break;
+		const ULONGLONG tNow = ::GetTickCount64();
+		if (tNow >= tDeadline)
+			break;
+		ULONGLONG tLeft = tDeadline - tNow;
+		if (tLeft > NATPMP_WAIT_SLICE)
+			tLeft = NATPMP_WAIT_SLICE;
+		timeval tv;
+		tv.tv_sec = 0;
+		tv.tv_usec = static_cast<long>(tLeft * 1000);
+		::select(0, &fds, NULL, NULL, &tv);
+	}
+
+	for (int i = 0; i < nCount; ++i)
+		if (pRequests[i].bOpen) {
+			closenatpmp(&pRequests[i].np);
+			pRequests[i].bOpen = false;
+		}
+}
+
+void CUPnPImplNatPmp::CheckEpoch(uint32 nEpoch)
+{
+	// RFC 6886 3.6: the epoch counts the seconds since the gateway last lost its mappings; one
+	// that went back means it restarted. The mappings are all asked for again at each renewal
+	// anyway, so this only tells why a renewal may have found them gone.
+	const ULONGLONG tNow = ::GetTickCount64();
+	if (m_tLastEpoch != 0) {
+		const uint32 nElapsed = static_cast<uint32>((tNow - m_tLastEpoch) / 1000);
+		if (nEpoch + 2 < m_nLastEpoch + nElapsed / 8 * 7)
+			DebugLogWarning(_T("NAT-PMP: the gateway %s was restarted, its port mappings are being created again"), (LPCTSTR)ipstr(m_nGateway));
+	}
+	m_nLastEpoch = nEpoch;
+	m_tLastEpoch = tNow;
+}
+
+bool CUPnPImplNatPmp::FindGateway(uint32 &nGateway)
+{
+	nGateway = 0;
+	LPCSTR pszBindAddr = thePrefs.GetBindAddrA();
+	if (pszBindAddr == NULL) {
+		// the gateway of the default route, as libnatpmp itself would pick it
+		MIB_IPFORWARDROW row = {};
+		if (::GetBestRoute(0, 0, &row) == NO_ERROR)
+			nGateway = row.dwForwardNextHop;
+		if (nGateway == 0)
+			DebugLog(_T("NAT-PMP: no default gateway found"));
+		return nGateway != 0;
+	}
+
+	// With a bind address, the gateway of the interface that owns it: the requests then
+	// leave from that interface, and the gateway maps the ports to the address they come
+	// from - the same interface miniupnpc's discovery is bound to.
+	const ULONG uBindAddr = inet_addr(pszBindAddr);
+	const ULONG uFlags = GAA_FLAG_INCLUDE_GATEWAYS | GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER;
+	ULONG uSize = 16384;
+	std::unique_ptr<BYTE[]> pBuffer;
+	ULONG uResult = ERROR_BUFFER_OVERFLOW;
+	for (int i = 0; i < 3 && uResult == ERROR_BUFFER_OVERFLOW; ++i) {
+		pBuffer.reset(new BYTE[uSize]);
+		uResult = ::GetAdaptersAddresses(AF_INET, uFlags, NULL, reinterpret_cast<PIP_ADAPTER_ADDRESSES>(pBuffer.get()), &uSize);
+	}
+	if (uResult == NO_ERROR) {
+		for (PIP_ADAPTER_ADDRESSES pAdapter = reinterpret_cast<PIP_ADAPTER_ADDRESSES>(pBuffer.get()); pAdapter != NULL && nGateway == 0; pAdapter = pAdapter->Next) {
+			bool bOwnsAddr = false;
+			for (PIP_ADAPTER_UNICAST_ADDRESS pUnicast = pAdapter->FirstUnicastAddress; pUnicast != NULL && !bOwnsAddr; pUnicast = pUnicast->Next)
+				bOwnsAddr = pUnicast->Address.lpSockaddr->sa_family == AF_INET
+					&& reinterpret_cast<const sockaddr_in*>(pUnicast->Address.lpSockaddr)->sin_addr.s_addr == uBindAddr;
+			if (!bOwnsAddr)
+				continue;
+			for (PIP_ADAPTER_GATEWAY_ADDRESS pGateway = pAdapter->FirstGatewayAddress; pGateway != NULL && nGateway == 0; pGateway = pGateway->Next)
+				if (pGateway->Address.lpSockaddr->sa_family == AF_INET)
+					nGateway = reinterpret_cast<const sockaddr_in*>(pGateway->Address.lpSockaddr)->sin_addr.s_addr;
+			break;
+		}
+	}
+	if (nGateway == 0)
+		DebugLog(_T("NAT-PMP: no IPv4 gateway found on the interface of the bind address %S"), pszBindAddr);
+	return nGateway != 0;
+}
