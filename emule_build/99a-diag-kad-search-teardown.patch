+///////////////////////////////////////////////////////////////////////////////
+// 99a diagnostics: access violations logged when they are raised
+//
+// Every access violation (and heap corruption report) is appended to
+// emule_diag_av.log next to the executable as soon as it is raised, before any
+// handler sees it. Wine ignores the ones raised inside a window procedure that
+// user32 called back, so without this they leave no trace but their damage.
+// The handler calls the Windows API only - no CRT, no heap.
+//
+extern UINT g_uMainThreadId;
+static HANDLE s_hDiagAVLog = INVALID_HANDLE_VALUE;
+static volatile LONG s_nDiagAVLogged;
+static __declspec(thread) bool s_bInDiagAVHandler;
+static ULONG_PTR s_uDiagImageBase;
+static ULONG_PTR s_uDiagImageSize;
+
+static void DiagFormatAddr(char *psz, ULONG_PTR uAddr)
+{
+	if (uAddr >= s_uDiagImageBase && uAddr < s_uDiagImageBase + s_uDiagImageSize)
+		wsprintfA(psz, "emule+0x%lx", (DWORD)(uAddr - s_uDiagImageBase));
+	else
+		wsprintfA(psz, "0x%08lx%08lx", (DWORD)((ULONGLONG)uAddr >> 32), (DWORD)uAddr);
+}
+
+static void DiagWrite(const char *psz, int nLen)
+{
+	DWORD dwWritten;
+	::WriteFile(s_hDiagAVLog, psz, (DWORD)nLen, &dwWritten, NULL);
+}
+
+static LONG CALLBACK DiagAVHandler(PEXCEPTION_POINTERS pExInfo) noexcept
+{
+	const EXCEPTION_RECORD *pRec = pExInfo->ExceptionRecord;
+	switch (pRec->ExceptionCode) {
+	case EXCEPTION_ACCESS_VIOLATION:
+	case EXCEPTION_DATATYPE_MISALIGNMENT:
+	case EXCEPTION_IN_PAGE_ERROR:
+	case 0xC0000374:	// STATUS_HEAP_CORRUPTION, from ntstatus.h
+		break;
+	default:
+		return EXCEPTION_CONTINUE_SEARCH;
+	}
+	// a fault while reading the stack below comes back here: let the __except take it
+	if (s_hDiagAVLog == INVALID_HANDLE_VALUE || s_bInDiagAVHandler || ::InterlockedIncrement(&s_nDiagAVLogged) > 200)
+		return EXCEPTION_CONTINUE_SEARCH;
+	s_bInDiagAVHandler = true;
+
+	const CONTEXT *pCtx = pExInfo->ContextRecord;
+#if defined _M_ARM64
+	const ULONG_PTR uPc = pCtx->Pc, uSp = pCtx->Sp, uLr = pCtx->Lr;
+#elif defined _M_X64
+	const ULONG_PTR uPc = pCtx->Rip, uSp = pCtx->Rsp, uLr = 0;
+#else
+	const ULONG_PTR uPc = pCtx->Eip, uSp = pCtx->Esp, uLr = 0;
+#endif
+	const bool bAV = pRec->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && pRec->NumberParameters >= 2;
+	char szPc[32], szLr[32], szAddr[32];
+	DiagFormatAddr(szPc, uPc);
+	DiagFormatAddr(szLr, uLr);
+	DiagFormatAddr(szAddr, bAV ? pRec->ExceptionInformation[1] : 0);
+	SYSTEMTIME st;
+	::GetLocalTime(&st);
+	const DWORD dwThread = ::GetCurrentThreadId();
+	char szLine[1024];
+	int nLen = wsprintfA(szLine, "%02u.%02u.%04u %02u:%02u:%02u.%03u thread %lu%s: exception %08lx at %s, lr %s"
+		, st.wDay, st.wMonth, st.wYear, st.wHour, st.wMinute, st.wSecond, st.wMilliseconds
+		, dwThread, (dwThread == g_uMainThreadId ? " (main)" : "")
+		, pRec->ExceptionCode, szPc, szLr);
+	if (bAV)
+		nLen += wsprintfA(szLine + nLen, ", %s %s"
+			, pRec->ExceptionInformation[0] == 0 ? "reading" : (pRec->ExceptionInformation[0] == 1 ? "writing" : "executing"), szAddr);
+	DiagWrite(szLine, nLen);
+
+	// the addresses inside eMule found on the stack: the callers, and some stale values
+	nLen = wsprintfA(szLine, "\r\n    stack:");
+	int nFound = 0;
+	__try {
+		const ULONG_PTR *puStack = reinterpret_cast<const ULONG_PTR*>(uSp);
+		for (int i = 0; i < 512 && nFound < 24; ++i) {
+			const ULONG_PTR u = puStack[i];
+			if (u > s_uDiagImageBase + 0x1000 && u < s_uDiagImageBase + s_uDiagImageSize) {
+				nLen += wsprintfA(szLine + nLen, " +0x%lx", (DWORD)(u - s_uDiagImageBase));
+				++nFound;
+			}
+		}
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		nLen += wsprintfA(szLine + nLen, " (end of readable stack)");
+	}
+	nLen += wsprintfA(szLine + nLen, "\r\n");
+	DiagWrite(szLine, nLen);
+
+	s_bInDiagAVHandler = false;
+	return EXCEPTION_CONTINUE_SEARCH;
+}
+
+static void InitDiagAVLog()
+{
+	WCHAR szPath[MAX_PATH + 32];
+	const DWORD dwLen = ::GetModuleFileNameW(NULL, szPath, MAX_PATH);
+	if (dwLen == 0 || dwLen >= MAX_PATH)
+		return;
+	WCHAR *pSlash = wcsrchr(szPath, L'\\');
+	if (pSlash == NULL)
+		return;
+	wcscpy_s(pSlash + 1, 32, L"emule_diag_av.log");
+	s_hDiagAVLog = ::CreateFileW(szPath, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+	if (s_hDiagAVLog == INVALID_HANDLE_VALUE)
+		return;
+	s_uDiagImageBase = reinterpret_cast<ULONG_PTR>(::GetModuleHandle(NULL));
+	const IMAGE_DOS_HEADER *pDos = reinterpret_cast<const IMAGE_DOS_HEADER*>(s_uDiagImageBase);
+	s_uDiagImageSize = reinterpret_cast<const IMAGE_NT_HEADERS*>(s_uDiagImageBase + pDos->e_lfanew)->OptionalHeader.SizeOfImage;
+	SYSTEMTIME st;
+	::GetLocalTime(&st);
+	char szLine[256];
+	DiagWrite(szLine, wsprintfA(szLine, "%02u.%02u.%04u %02u:%02u:%02u.%03u process %lu started, image base 0x%08lx%08lx, size 0x%lx\r\n"
+		, st.wDay, st.wMonth, st.wYear, st.wHour, st.wMinute, st.wSecond, st.wMilliseconds
+		, ::GetCurrentProcessId(), (DWORD)((ULONGLONG)s_uDiagImageBase >> 32), (DWORD)s_uDiagImageBase, (DWORD)s_uDiagImageSize));
+	::AddVectoredExceptionHandler(1, DiagAVHandler);
+}
+
 
