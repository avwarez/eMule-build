+// 99a diagnostics: read a contact through a pointer that may not point to one
+static bool DiagProbeContact(const CContact *pContact, uint32 &ruMagic, uint32 &ruInUse)
+{
+	__try {
+		ruMagic = pContact->GetDiagMagic();
+		ruInUse = pContact->GetDiagInUse();
+		return true;
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
+
+bool CSearch::DiagProbe(const CSearch *pSearch, uint32 &ruMagic, uint32 &ruSearchID, uint32 &ruType, size_t &rnDelete)
+{
+	__try {
+		ruMagic = pSearch->m_uDiagMagic;
+		ruSearchID = pSearch->m_uSearchID;
+		ruType = pSearch->m_uType;
+		rnDelete = pSearch->m_listDelete.size();
+		return true;
+	} __except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
