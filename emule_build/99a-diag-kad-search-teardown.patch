+// 99a diagnostics: a search is probed before it is deleted; one that cannot be read or
+// is not a live search is reported and left alone
+static void DiagDeleteSearch(CSearch *pSearch, LPCTSTR pszWhere, bool bLogDelete)
+{
+	uint32 uMagic, uSearchID, uType;
+	size_t nDelete;
+	if (!CSearch::DiagProbe(pSearch, uMagic, uSearchID, uType, nDelete))
+		DebugLogError(_T("KadDiag: %s: search %p cannot be read - not deleted"), pszWhere, (void*)pSearch);
+	else if (uMagic != KADDIAG_SEARCH_ALIVE)
+		DebugLogError(_T("KadDiag: %s: search %p is not a live search (magic %08x, id %u, type %u) - not deleted"), pszWhere, (void*)pSearch, uMagic, uSearchID, uType);
+	else {
+		if (bLogDelete)
+			DebugLog(_T("KadDiag: %s: deleting search %u (type %u, %u temporary contacts)"), pszWhere, uSearchID, uType, (UINT)nDelete);
+		delete pSearch;
+	}
+}
