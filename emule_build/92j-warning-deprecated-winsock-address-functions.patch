 	snprintf(pszAddress, iMaxAddress, "%u.%u.%u.%u", pucIP[0], pucIP[1], pucIP[2], pucIP[3]);
 }
 
+uint32 IPv4FromStringA(LPCSTR pszAddress)
+{
+	// Same contract as the deprecated inet_addr(): the address in network byte order, or
+	// INADDR_NONE. WSAStringToAddress() parses the same forms (dotted decimal, and the shorter,
+	// octal and hexadecimal ones), but it wants the whole string to be the address, while
+	// inet_addr() stopped at the first blank; and it also takes a ":port" suffix, which
+	// inet_addr() refused. And it read a lone blank as 0.0.0.0, as ws2_32's conformance tests in
+	// Wine pin down for Windows.
+	if (pszAddress == NULL)
+		return INADDR_NONE;
+	if (pszAddress[0] == ' ' && pszAddress[1] == '\0')
+		return 0;
+	CStringW strAddress(pszAddress, (int)strcspn(pszAddress, " \t\n\v\f\r"));
+	if (strAddress.IsEmpty() || strAddress.Find(L':') >= 0)
+		return INADDR_NONE;
+	SOCKADDR_IN sa;
+	int iLen = (int)sizeof sa;
+	int iResult = ::WSAStringToAddressW(strAddress.GetBuffer(), AF_INET, NULL, (LPSOCKADDR)&sa, &iLen);
+	strAddress.ReleaseBuffer();
+	return (iResult == 0) ? sa.sin_addr.s_addr : INADDR_NONE;
+}
