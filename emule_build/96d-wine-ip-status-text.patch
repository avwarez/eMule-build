+// The IP_STATUS codes IcmpSendEcho() reports, by name. GetIpErrorString() is not used for
+// them: Wine has only a stub of it, which aborts the program, and the system message table
+// cannot stand in for it, as IP_BUF_TOO_SMALL to IP_DEST_PROT_UNREACHABLE share their numbers
+// with Winsock errors (WSAHOST_NOT_FOUND to WSANO_DATA) and the other codes have no message.
+#define IP_STATUS_NAME(status)	{status, _T(#status)}
+static const struct
+{
+	DWORD	nStatus;
+	LPCTSTR	pszName;
+} s_aIpStatusNames[] =
+{
+	IP_STATUS_NAME(IP_BUF_TOO_SMALL),
+	IP_STATUS_NAME(IP_DEST_NET_UNREACHABLE),
+	IP_STATUS_NAME(IP_DEST_HOST_UNREACHABLE),
+	IP_STATUS_NAME(IP_DEST_PROT_UNREACHABLE),
+	IP_STATUS_NAME(IP_DEST_PORT_UNREACHABLE),
+	IP_STATUS_NAME(IP_NO_RESOURCES),
+	IP_STATUS_NAME(IP_BAD_OPTION),
+	IP_STATUS_NAME(IP_HW_ERROR),
+	IP_STATUS_NAME(IP_PACKET_TOO_BIG),
+	IP_STATUS_NAME(IP_REQ_TIMED_OUT),
+	IP_STATUS_NAME(IP_BAD_REQ),
+	IP_STATUS_NAME(IP_BAD_ROUTE),
+	IP_STATUS_NAME(IP_TTL_EXPIRED_TRANSIT),
+	IP_STATUS_NAME(IP_TTL_EXPIRED_REASSEM),
+	IP_STATUS_NAME(IP_PARAM_PROBLEM),
+	IP_STATUS_NAME(IP_SOURCE_QUENCH),
+	IP_STATUS_NAME(IP_OPTION_TOO_BIG),
+	IP_STATUS_NAME(IP_BAD_DESTINATION),
+	IP_STATUS_NAME(IP_ADDR_DELETED),
+	IP_STATUS_NAME(IP_SPEC_MTU_CHANGE),
+	IP_STATUS_NAME(IP_MTU_CHANGE),
+	IP_STATUS_NAME(IP_UNLOAD),
+	IP_STATUS_NAME(IP_GENERAL_FAILURE),
+	IP_STATUS_NAME(IP_PENDING)
+};
+#undef IP_STATUS_NAME
+
 void Pinger::PIcmpErr(LPCTSTR pszMsg, DWORD nICMPErr)
 {
-	DWORD dwSize = 511;
-	CStringW sErr;
-	bool b = (GetIpErrorString(nICMPErr, sErr.GetBuffer(dwSize), &dwSize) == NO_ERROR);
-	sErr.ReleaseBuffer(); //the string has trailing spaces!
+	CString sErr;
+	for (unsigned i = 0; i < _countof(s_aIpStatusNames); ++i)
+		if (s_aIpStatusNames[i].nStatus == nICMPErr) {
+			sErr.Format(_T("%s (%lu)"), s_aIpStatusNames[i].pszName, nICMPErr);
+			break;
+		}
+	if (sErr.IsEmpty())
+		sErr = GetErrorMessage(nICMPErr, 1);	// not an IP_STATUS code: a system error
 	theApp.QueueDebugLogLine(false, _T("%sPinger: %s")
 		, pszMsg ? pszMsg : _T("")
-		, (LPCTSTR)(b ? (CString)sErr.Trim() : GetErrorMessage(nICMPErr, 1)));
+		, (LPCTSTR)sErr);
 }
