+void CEMSocket::DiagCheckOverlappedSend(LPCTSTR pszWhere)
+{
+	DWORD dwTransferred = 0, dwFlags = 0;
+	if (!::WSAGetOverlappedResult(GetSocketHandle(), &m_PendingSendOperation, &dwTransferred, FALSE, &dwFlags))
+		return;
+	ULONGLONG uSubmitted = 0;
+	for (INT_PTR i = m_aBufferSend.GetCount(); --i >= 0;)
+		uSubmitted += m_aBufferSend[i].len;
+	::InterlockedIncrement(&g_nDiagSendsChecked);
+	if (dwTransferred == uSubmitted)
+		return;
+	::InterlockedIncrement(&g_nDiagShortSends);
+	if (uSubmitted > dwTransferred)
+		::InterlockedExchangeAdd(&g_nDiagShortSendBytes, (LONG)(uSubmitted - dwTransferred));
+	theApp.QueueDebugLogLineEx(LOG_WARNING, _T("UPDIAG|overlapped send mismatch at %s, submitted=%I64u transferred=%u buffers=%d")
+		, pszWhere, uSubmitted, dwTransferred, (int)m_aBufferSend.GetCount());
+}
