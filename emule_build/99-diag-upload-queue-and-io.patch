+//UPDIAG: only the throttler thread calls this, so the timestamp needs no interlocking.
+DWORD CClientReqSocket::DbgTrackStarved(bool bStarved)
+{
+	if (!bStarved) {
+		m_dwDiagStarvedSince = 0;
+		return 0;
+	}
+	const DWORD dwNow = ::GetTickCount();
+	if (m_dwDiagStarvedSince == 0) {
+		m_dwDiagStarvedSince = dwNow;
+		return 1;
+	}
+	return max(dwNow - m_dwDiagStarvedSince, 1u);
+}
