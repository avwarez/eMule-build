+//UPDIAG: called from the throttler thread only, so the timestamps below need no interlocking.
+bool CEMSocket::DiagNoteBusy(bool bBusy)
+{
+	const DWORD dwNow = ::GetTickCount();
+	if (bBusy) {
+		if (m_dwDiagBusySince == 0) {
+			m_dwDiagBusySince = dwNow;
+			++m_nDiagBusySpells;
+		}
+	} else if (m_dwDiagBusySince != 0) {
+		const DWORD dwSpell = dwNow - m_dwDiagBusySince;
+		m_dwDiagBusyTotal += dwSpell;
+		if (dwSpell > m_dwDiagBusyMax)
+			m_dwDiagBusyMax = dwSpell;
+		m_dwDiagBusySince = 0;
+	}
+	return bBusy;
+}
