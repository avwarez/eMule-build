--- a/srchybrid/UploadDiskIOThread.cpp
+++ b/srchybrid/UploadDiskIOThread.cpp
@@ -44,6 +44,7 @@ static char THIS_FILE[] = __FILE__;
 #define RUN_IDLE	1
 #define RUN_WORK	2
 #define WAKEUP		((ULONG_PTR)(~0))
+#define IOPORT_WAIT	500				// ms between two unsolicited passes over the upload list
 
 IMPLEMENT_DYNCREATE(CUploadDiskIOThread, CWinThread)
 
