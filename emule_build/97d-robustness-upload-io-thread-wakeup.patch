-	{
+	// The wait is bounded rather than INFINITE. Every caller that posts a wakeup here does so
+	// as a consequence of data moving: a block request arriving from a peer, or the throttler
+	// having just sent something. When every socket that holds data is blocked neither happens
+	// any more, so nothing is left to post one and the slots whose sockets are still free never
+	// get their next block prepared. A pass twice a second costs one walk of the upload list and
+	// restores the behaviour of the loop this thread replaced, which waited with a timeout.
+	while (m_Run) {
+		if (!::GetQueuedCompletionStatus(m_hPort, &dwRead, &completionKey, (LPOVERLAPPED*)&pCurIO, IOPORT_WAIT)) {
+			if (pCurIO != NULL || ::GetLastError() != WAIT_TIMEOUT)
+				break;			// a dequeued operation failed, or the port itself did
+			completionKey = WAKEUP;	// nothing was queued; look at the upload list anyway
+			dwRead = 0;
+		}
+		if (!completionKey)
+			break;
