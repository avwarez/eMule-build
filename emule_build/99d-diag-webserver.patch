+// WEBDIAG: temporary instrumentation, removed together with this patch. Counters live
+// in WebSocket.cpp, next to the threads that move them.
+extern volatile LONG g_nWebDiagConnLive;
+extern volatile LONG g_nWebDiagReqLive;
+extern volatile LONG g_nWebDiagAccepted;
+extern volatile LONG g_nWebDiagRejected;
+
+//WEBDIAG: every SendMessage() in this file is sent from a web connection thread to the
+//GUI thread, and blocks the web thread until the GUI picks it up. If the GUI is busy,
+//the browser waits with it - which is invisible from outside. Time each one and say so.
+static LRESULT WebDiagSendMessage(int nLine, HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
+{
+	const DWORD dwStart = ::GetTickCount();
+	theApp.QueueDebugLogLineEx(LOG_INFO, _T("WEBDIAG|SendMessage line %d begin, msg=%u wp=%u"), nLine, uMsg, (unsigned)wParam);
+	const LRESULT lRes = ::SendMessage(hWnd, uMsg, wParam, lParam);
+	const DWORD dwWaited = ::GetTickCount() - dwStart;
+	theApp.QueueDebugLogLineEx(dwWaited >= 50 ? LOG_WARNING : LOG_INFO
+		, _T("WEBDIAG|SendMessage line %d end after %ums%s"), nLine, dwWaited
+		, (dwWaited >= 50) ? _T(" - the GUI thread held this web thread") : _T(""));
+	return lRes;
+}
