+// WEBDIAG: temporary instrumentation for the web interface, removed together with this
+// patch. Everything below is counters and log lines; nothing here changes what the
+// server does. The web interface writes almost nothing to the log today, so when it
+// stops answering there is no trace at all - these lines are that trace.
+volatile LONG g_nWebDiagConnSeq;		//WEBDIAG - connection ids, handed out on accept
+volatile LONG g_nWebDiagConnLive;	//WEBDIAG - connection threads alive right now
+volatile LONG g_nWebDiagReqSeq;		//WEBDIAG - request ids
+volatile LONG g_nWebDiagReqLive;	//WEBDIAG - requests being processed right now
+volatile LONG g_nWebDiagAccepted;	//WEBDIAG - accepted connections since start
+volatile LONG g_nWebDiagRejected;	//WEBDIAG - refused by the allowed-IP list
+
+//WEBDIAG: a wait that ends for any other reason than the event is the interesting case,
+//so name the result instead of printing a bare number.
+LPCTSTR WebDiagWaitName(DWORD dwRes)
+{
+	switch (dwRes) {
+	case WAIT_OBJECT_0:			return _T("event");
+	case WAIT_OBJECT_0 + 1:		return _T("terminate");
+	case WAIT_TIMEOUT:			return _T("timeout");
+	case WAIT_ABANDONED_0:		return _T("abandoned");
+	case WAIT_ABANDONED_0 + 1:	return _T("abandoned-terminate");
+	case WAIT_FAILED:			return _T("FAILED");
+	}
+	return _T("?");
