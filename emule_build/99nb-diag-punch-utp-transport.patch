+// at most 10 lines a minute for what a remote peer can trigger at will
+bool CPunchTransport::DiagRateOk()
+{
+	const DWORD dwNow = ::GetTickCount();
+	if (dwNow >= m_dwDiagRateWindow + MIN2MS(1)) {
+		m_dwDiagRateWindow = dwNow;
+		m_uDiagInWindow = 0;
+	}
+	return ++m_uDiagInWindow <= 10;
+}
