+//UPDIAG: the blocked state is reported by the accessor below; this only accumulates the spells
+//that have ended, which is what separates a socket blocked in short bursts by ordinary flow
+//control from one held in a single spell by a peer that has stopped reading.
+bool CEMSocket::DiagNoteBusy(bool bBusy)
+{
+	if (!bBusy && m_dwDiagBusyLast != 0) {
+		const DWORD dwSpell = ::GetTickCount() - m_dwDiagBusyLast;
+		m_dwDiagBusyTotal += dwSpell;
+		if (dwSpell > m_dwDiagBusyMax)
+			m_dwDiagBusyMax = dwSpell;
+		m_dwDiagBusyLast = 0;
+	} else if (bBusy && m_dwDiagBusyLast == 0) {
+		m_dwDiagBusyLast = m_dwSendBlockedSince ? m_dwSendBlockedSince : ::GetTickCount();
+		++m_nDiagBusySpells;
+	}
+	return bBusy;
+}
