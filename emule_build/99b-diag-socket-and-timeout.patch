+//UPDIAG: compare what the completed overlapped send actually wrote with what was submitted.
+void CEMSocket::DiagCheckOverlappedSend(LPCTSTR pszWhere)
+{
+	//UPDIAG: counted here, defined and reported by the upload queue half of the instrumentation.
+	extern volatile LONG g_nDiagShortSends, g_nDiagShortSendBytes, g_nDiagSendsChecked;
+	DWORD dwTransferred = 0, dwFlags = 0;
+	if (!::WSAGetOverlappedResult(GetSocketHandle(), &m_PendingSendOperation, &dwTransferred, FALSE, &dwFlags))
+		return;
+	ULONGLONG uSubmitted = 0;
+	for (INT_PTR i = m_aBufferSend.GetCount(); --i >= 0;)
+		uSubmitted += m_aBufferSend[i].len;
+	::InterlockedIncrement(&g_nDiagSendsChecked);
+	if (dwTransferred == uSubmitted)
+		return;
+	::InterlockedIncrement(&g_nDiagShortSends);
+	if (uSubmitted > dwTransferred)
+		::InterlockedExchangeAdd(&g_nDiagShortSendBytes, (LONG)(uSubmitted - dwTransferred));
+	theApp.QueueDebugLogLineEx(LOG_WARNING, _T("UPDIAG|overlapped send mismatch at %s, submitted=%I64u transferred=%u buffers=%d")
+		, pszWhere, uSubmitted, dwTransferred, (int)m_aBufferSend.GetCount());
+}
+
+//UPDIAG: the state of the send path, asked from the throttler's thread. The decisive field is
+//ovres: a pending send that the network has not finished reads WSA_IO_INCOMPLETE, while one that
+//finished and is still marked pending was never collected, and the socket will refuse every
+//further send for as long as that lasts.
+void CEMSocket::DbgGetDiagInfo(CString &rstrOut)
+{
+	CSingleLock lockSend(&sendLocker, TRUE);
+	int nOvRes;
+	DWORD dwTransferred = 0;
+	if (!m_bPendingSendOv)
+		nOvRes = 0;
+	else {
+		DWORD dwFlags = 0;
+		nOvRes = ::WSAGetOverlappedResult(GetSocketHandle(), &m_PendingSendOperation, &dwTransferred, FALSE, &dwFlags)
+			? 1 : -::WSAGetLastError();
+	}
+	rstrOut.Format(_T("pendov=%d ovage=%ums ovbytes=%u ovres=%d ovdone=%u std=%d ctrl=%d sendbuf=%u")
+		_T(" busyage=%ums busymax=%ums busytotal=%ums spells=%ld")
+		_T(" calls=%ld zero=%ld conn=%u recvbytes=%I64u quiet=%dms")
+		, (int)m_bPendingSendOv
+		, GetSendBlockedAge()
+		, m_nDiagSendOvBytes, nOvRes, dwTransferred
+		, (int)standardpacket_queue.GetCount(), (int)controlpacket_queue.GetCount()
+		, sendbuffer != NULL ? m_sendblen - m_sent : 0
+		, m_dwDiagBusyLast != 0 ? ::GetTickCount() - m_dwDiagBusyLast : 0
+		, m_dwDiagBusyMax, m_dwDiagBusyTotal, m_nDiagBusySpells
+		, (LONG)m_nDiagSendCalls, (LONG)m_nDiagSendZero, (unsigned)byConnected, m_nDiagRecvBytes
+		, m_dwDiagLastRecv != 0 ? (int)(::GetTickCount() - m_dwDiagLastRecv) : -1);
+}
