+		theApp.QueueDebugLogLineEx(LOG_WARNING
+			, _T("UPDIAG|listen STOPPED, sockets=%u max=%u half=%u maxhalf=%u")
+			, GetOpenSockets(), thePrefs.GetMaxConnections()
+			, GetTotalHalfCon(), thePrefs.GetMaxHalfConnections());
 	bListening = false;
 	++maxconnectionreached;
 }
