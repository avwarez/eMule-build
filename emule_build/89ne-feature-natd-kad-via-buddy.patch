+///////////////////////////////////////////////////////////////////////////////
+// D1
+
+// Once a minute, as CRoutingZone::OnSmallTimer for the routing bins: a hello to the contacts
+// due for one (at most one in ten of them), and away with those that did not answer.
+void CNatTraversal::Impl::KadTimer()
+{
+	if (!Kademlia::CKademlia::IsRunning()) {
+		kadContacts.clear();
+		kadRoutes.clear();
+		return;
+	}
+	const DWORD dwNow = ::GetTickCount();
+	for (std::map<uint64, SRoute>::iterator it = kadRoutes.begin(); it != kadRoutes.end();)
+		if (dwNow - it->second.dwSeen >= D1_ROUTE_LIFETIME)
+			it = kadRoutes.erase(it);
+		else
+			++it;
+	size_t nChecks = (std::max)((size_t)1, kadContacts.size() / 10);
+	for (std::map<Kademlia::CUInt128, SViaBuddy>::iterator it = kadContacts.begin(); it != kadContacts.end();) {
+		SViaBuddy &c = it->second;
+		if (c.bVerified ? dwNow - c.dwHeard >= D1_LIFETIME : dwNow - c.dwAdded >= D1_UNVERIFIED_LIFETIME) {
+			it = kadContacts.erase(it);
+			continue;
+		}
+		const bool bDue = c.bVerified ? (dwNow - c.dwHeard >= D1_CHECK_AFTER) : (c.dwChecked == 0);
+		if (bDue && nChecks > 0 && (c.dwChecked == 0 || dwNow - c.dwChecked >= D1_RECHECK)) {
+			--nChecks;
+			c.dwChecked = dwNow;
+			const Kademlia::CUInt128 uID(it->first);
+			Kademlia::CKademlia::GetUDPListener()->SendMyDetails(KADEMLIA2_HELLO_REQ, c.uIP, c.uUDPPort, c.uVersion, Kademlia::CKadUDPKey(), &uID, false);
+		}
+		++it;
+	}
+}
