+// Only with an endpoint-independent mapping (the simple case): our answers then leave from the
+// port our hello came from, and whoever asked knows them by IP and port, as any Kad answer.
+bool CNatTraversal::KadGetMyBuddy(uint32 &dwBuddyIP, uint16 &nBuddyPort) const
+{
+	if (!m_pImpl->pAgent->directPunchable() || !Kademlia::CUDPFirewallTester::IsFirewalledUDP(true) || theApp.clientlist->GetBuddyStatus() != Connected)
+		return false;
+	const CUpDownClient *pBuddy = theApp.clientlist->GetBuddy();
+	if (pBuddy == NULL || pBuddy->GetIP() == 0 || pBuddy->GetUDPPort() == 0)
+		return false;
+	dwBuddyIP = pBuddy->GetIP();
+	nBuddyPort = pBuddy->GetUDPPort();
+	return true;
+}
