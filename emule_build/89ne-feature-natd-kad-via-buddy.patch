+			fileIO.ReadUInt128(uID);
+			const uint32 uIPResult = fileIO.ReadUInt32();
+			const uint16 uUDPPortResult = fileIO.ReadUInt16();
+			const uint16 uTCPPortResult = fileIO.ReadUInt16();
+			const uint8 uVersion = fileIO.ReadUInt8();
+			const uint32 uBuddyIP = fileIO.ReadUInt32();
+			const uint16 uBuddyPort = fileIO.ReadUInt16();
+			if (uBuddyIP == 0 || uBuddyPort == 0 || uVersion < KADEMLIA_VERSION6_49aBETA)
+				continue;
+			const uint32 dwNetIP = htonl(uIPResult);
+			const uint32 dwNetBuddyIP = htonl(uBuddyIP);
+			if (!IsGoodIPPort(dwNetIP, uUDPPortResult) || theApp.ipfilter->IsFiltered(dwNetIP)
+				|| !IsGoodIPPort(dwNetBuddyIP, uBuddyPort) || theApp.ipfilter->IsFiltered(dwNetBuddyIP))
+			{
+				continue;
+			}
+			theApp.nattraversal->KadAddViaBuddy(uID, uIPResult, uUDPPortResult, uTCPPortResult, uVersion, uBuddyIP, uBuddyPort, false);
+			CContact *pContact = new CContact(uID, uIPResult, uUDPPortResult, uTCPPortResult, uTarget, uVersion, CKadUDPKey(), false);
+			pContact->SetViaBuddy(uBuddyIP, uBuddyPort);
+			cResults.push_back(pContact);
+		}
+	} catch (...) {
+		for (ContactArray::const_iterator itContact = cResults.begin(); itContact != cResults.end(); ++itContact)
+			delete *itContact;
+		throw;
+	}
+	if (CSearchManager::TakesViaBuddyContacts(uTarget))
+		CSearchManager::ProcessResponse(uTarget, uIP, uUDPPort, cResults);
+	else
+		for (ContactArray::const_iterator itContact = cResults.begin(); itContact != cResults.end(); ++itContact)
+			delete *itContact;
+}
