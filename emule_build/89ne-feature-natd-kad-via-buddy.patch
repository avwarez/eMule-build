+
+void CNatTraversal::KadNoteRequest(uint32 uIP)
+{
+	std::deque<std::pair<uint32, DWORD>> &requests = m_pImpl->kadRequests;
+	const DWORD dwNow = ::GetTickCount();
+	while (!requests.empty() && (requests.size() >= 512 || dwNow - requests.front().second >= (DWORD)SEC2MS(180)))
+		requests.pop_front();
+	requests.emplace_back(uIP, dwNow);
+}
+
+bool CNatTraversal::KadTakeRequest(uint32 uIP)
+{
+	std::deque<std::pair<uint32, DWORD>> &requests = m_pImpl->kadRequests;
+	const DWORD dwNow = ::GetTickCount();
+	for (std::deque<std::pair<uint32, DWORD>>::iterator it = requests.begin(); it != requests.end(); ++it)
+		if (it->first == uIP && dwNow - it->second < (DWORD)SEC2MS(180)) {
+			requests.erase(it);
+			return true;
+		}
+	return false;
+}
+
+// The relay: OP_REASKCALLBACKUDP to the buddy, with the buddy ID it checks and a file hash it does
+// not read, then the marker, who sends and the way back to it (1: through its buddy, with the
+// buddy's IP, port and ID; 0: directly), and the Kad packet. The buddy forwards the rest as it is.
+bool CNatTraversal::KadRelay(Packet *pPacket, uint32 uIP, uint16 uUDPPort)
+{
+	Impl &impl = *m_pImpl;
+	uint32 uBuddyIP = 0;
+	uint16 uBuddyPort = 0;
+	uchar abyBuddyID[MDX_DIGEST_SIZE];
+	for (std::map<Kademlia::CUInt128, SViaBuddy>::const_iterator it = impl.kadContacts.begin(); it != impl.kadContacts.end(); ++it)
+		if (it->second.uIP == uIP && it->second.uUDPPort == uUDPPort) {
+			uBuddyIP = it->second.uBuddyIP;
+			uBuddyPort = it->second.uBuddyPort;
+			Kademlia::CUInt128 uBuddyID(true);
+			uBuddyID.Xor(it->first);
+			uBuddyID.ToByteArray(abyBuddyID);
+			break;
+		}
+	if (uBuddyIP == 0) {
+		const std::map<uint64, SRoute>::const_iterator it = impl.kadRoutes.find(EndpointKey(uIP, uUDPPort));
+		if (it == impl.kadRoutes.end())
+			return false;
+		uBuddyIP = it->second.uBuddyIP;
+		uBuddyPort = it->second.uBuddyPort;
+		md4cpy(abyBuddyID, it->second.abyBuddyID);
+	}
+
+	CSafeMemFile data(128 + pPacket->size);
+	static const uchar s_abyNoFile[MDX_DIGEST_SIZE] = {};
+	data.WriteHash16(abyBuddyID);
+	data.WriteHash16(s_abyNoFile);
+	WriteMarker(data, NATD_MARKER_MESSAGE, RandomUInt64());
+	data.WriteHash16(thePrefs.GetUserHash());
+	uint32 dwMyBuddyIP;
+	uint16 nMyBuddyPort;
+	if (KadGetMyBuddy(dwMyBuddyIP, nMyBuddyPort)) {
+		data.WriteUInt8(1);
+		data.WriteUInt32(dwMyBuddyIP);
+		data.WriteUInt16(nMyBuddyPort);
+		Kademlia::CUInt128 uMyBuddyID(true);
+		uMyBuddyID.Xor(Kademlia::CKademlia::GetPrefs()->GetKadID());
+		uchar abyMyBuddyID[MDX_DIGEST_SIZE];
+		uMyBuddyID.ToByteArray(abyMyBuddyID);
+		data.WriteHash16(abyMyBuddyID);
+	} else {
+		data.WriteUInt8(0);
+		data.WriteUInt16(thePrefs.GetPort());
+	}
+	data.WriteUInt8(pPacket->prot);
+	data.WriteUInt8(pPacket->opcode);
+	if (pPacket->size > 0)
+		data.Write(pPacket->pBuffer, pPacket->size);
+	delete pPacket;
+
+	Packet *pRelay = new Packet(data, OP_EMULEPROT);
+	pRelay->opcode = OP_REASKCALLBACKUDP;
+	theStats.AddUpDataOverheadKad(pRelay->size);
+	theApp.clientudp->SendPacket(pRelay, htonl(uBuddyIP), uBuddyPort, false, NULL, false, 0);
+	return true;
+}
+
+// Whatever goes wrong in a relayed packet stays here: the buddy connection it came over is not
+// to blame for it.
+void CNatTraversal::OnRelay(CSafeMemFile &data, uint32 dwIP, uint16 nPort)
+{
+	CString strError;
+	try {
+		RelayToKad(data, dwIP, nPort);
+	} catch (CFileException *ex) {
+		ex->Delete();
+		strError = _T("Invalid packet received");
+	} catch (CMemoryException *ex) {
+		ex->Delete();
+		strError = _T("Memory exception");
+	} catch (const CString &ex) {
+		strError = ex;
+	} catch (Kademlia::CIOException *ex) {
+		ex->Delete();
+		strError = _T("Invalid packet received");
+	} catch (CException *ex) {
+		ex->Delete();
+		strError = _T("General packet error");
+	}
+	m_pImpl->bKadFromRelay = false;
+	if (thePrefs.GetVerbose() && !strError.IsEmpty())
+		DebugLogWarning(_T("NAT traversal: Kad packet relayed from %s:%u: %s"), (LPCTSTR)ipstr(dwIP), nPort, (LPCTSTR)strError);
+}
+
+void CNatTraversal::RelayToKad(CSafeMemFile &data, uint32 dwIP, uint16 nPort)
+{
+	Impl &impl = *m_pImpl;
+	if (!Kademlia::CKademlia::IsRunning())
+		return;
+	uchar abySender[MDX_DIGEST_SIZE];
+	data.ReadHash16(abySender);
+	if (md4equ(abySender, thePrefs.GetUserHash()))
+		return;
+	const uint32 uIP = ntohl(dwIP);
+	if (data.ReadUInt8() == 1) {
+		SRoute route;
+		route.uBuddyIP = ntohl(data.ReadUInt32());
+		route.uBuddyPort = data.ReadUInt16();
+		data.ReadHash16(route.abyBuddyID);
+		route.dwSeen = ::GetTickCount();
+		if (!KadAddressOk(route.uBuddyIP, route.uBuddyPort))
+			return;
+		if (impl.kadRoutes.size() < D1_MAX_ROUTES || impl.kadRoutes.find(EndpointKey(uIP, nPort)) != impl.kadRoutes.end())
+			impl.kadRoutes[EndpointKey(uIP, nPort)] = route;
+	} else
+		(void)data.ReadUInt16();
+
+	// the Kad packet, as CClientUDPSocket::OnReceive takes it; nothing else goes on the relay
+	const UINT nLen = (UINT)(data.GetLength() - data.GetPosition());
+	if (nLen < 2)
+		return;
+	std::vector<BYTE> packet(nLen);
+	data.Read(packet.data(), nLen);
+	if (packet[0] == OP_KADEMLIAPACKEDPROT) {
+		std::vector<BYTE> unpacked;
+		uLongf nUnpacked = 0;
+		int iResult = Z_BUF_ERROR;
+		for (uLongf nSize = nLen * 10 + 300; iResult == Z_BUF_ERROR && nSize < 250000; nSize *= 2) {
+			unpacked.resize(nSize + 2);
+			nUnpacked = nSize;
+			iResult = uncompress(&unpacked[2], &nUnpacked, &packet[2], nLen - 2);
+		}
+		if (iResult != Z_OK)
+			return;
+		unpacked[0] = OP_KADEMLIAHEADER;
+		unpacked[1] = packet[1];
+		unpacked.resize(nUnpacked + 2);
+		packet.swap(unpacked);
+	} else if (packet[0] != OP_KADEMLIAHEADER)
+		return;
+	theStats.AddDownDataOverheadKad((uint32)packet.size());
+	impl.bKadFromRelay = true;
+	Kademlia::CKademlia::ProcessPacket(packet.data(), (uint32)packet.size(), uIP, nPort, false, Kademlia::CKadUDPKey());
+	impl.bKadFromRelay = false;
 }
 
