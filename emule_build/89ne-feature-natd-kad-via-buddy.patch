+void CNatTraversal::KadAddViaBuddy(const Kademlia::CUInt128 &uID, uint32 uIP, uint16 uUDPPort, uint16 uTCPPort, uint8 uVersion, uint32 uBuddyIP, uint16 uBuddyPort, bool bVerified)
+{
+	if (!Kademlia::CKademlia::IsRunning() || uID == Kademlia::CKademlia::GetPrefs()->GetKadID() || uVersion < KADEMLIA_VERSION6_49aBETA)
+		return;
+	// the same checks eMule makes on a contact's address, on the buddy's too: the packets go there
+	if (!KadAddressOk(uIP, uUDPPort) || !KadAddressOk(uBuddyIP, uBuddyPort))
+		return;
+	Impl &impl = *m_pImpl;
+	const DWORD dwNow = ::GetTickCount();
+	std::map<Kademlia::CUInt128, SViaBuddy>::iterator it = impl.kadContacts.find(uID);
+	if (it != impl.kadContacts.end()) {
+		// as CRoutingZone::Add: a contact is updated only by its own hello
+		if (!bVerified)
+			return;
+		SViaBuddy &c = it->second;
+		c.uIP = uIP;
+		c.uUDPPort = uUDPPort;
+		c.uTCPPort = uTCPPort;
+		c.uVersion = uVersion;
+		c.uBuddyIP = uBuddyIP;
+		c.uBuddyPort = uBuddyPort;
+		c.bVerified = true;
+		c.dwHeard = dwNow;
+		return;
+	}
+	if (impl.kadContacts.size() >= D1_MAX_CONTACTS)
+		return;
+	const SViaBuddy c = {uIP, uUDPPort, uTCPPort, uVersion, uBuddyIP, uBuddyPort, bVerified, dwNow, bVerified ? dwNow : 0, 0};
+	impl.kadContacts[uID] = c;
+}
+
+void CNatTraversal::KadRemoveViaBuddy(const Kademlia::CUInt128 &uID)
+{
+	m_pImpl->kadContacts.erase(uID);
+}
+
+bool CNatTraversal::KadIsViaBuddy(uint32 uIP, uint16 uUDPPort) const
+{
+	for (std::map<Kademlia::CUInt128, SViaBuddy>::const_iterator it = m_pImpl->kadContacts.begin(); it != m_pImpl->kadContacts.end(); ++it)
+		if (it->second.uIP == uIP && it->second.uUDPPort == uUDPPort)
+			return true;
+	return false;
+}
+
+void CNatTraversal::KadGetClosest(const Kademlia::CUInt128 &uTarget, uint32 uMax, bool bOnlyVerified, std::vector<Kademlia::CContact*> &rResults) const
+{
+	std::map<Kademlia::CUInt128, std::map<Kademlia::CUInt128, SViaBuddy>::const_iterator> mapByDistance;
+	for (std::map<Kademlia::CUInt128, SViaBuddy>::const_iterator it = m_pImpl->kadContacts.begin(); it != m_pImpl->kadContacts.end(); ++it)
+		if (it->second.bVerified || !bOnlyVerified) {
+			Kademlia::CUInt128 uDistance(it->first);
+			uDistance.Xor(uTarget);
+			mapByDistance[uDistance] = it;
+		}
+	for (std::map<Kademlia::CUInt128, std::map<Kademlia::CUInt128, SViaBuddy>::const_iterator>::const_iterator it = mapByDistance.begin(); it != mapByDistance.end() && rResults.size() < uMax; ++it) {
+		const SViaBuddy &c = it->second->second;
+		Kademlia::CContact *pContact = new Kademlia::CContact(it->second->first, c.uIP, c.uUDPPort, c.uTCPPort, uTarget, c.uVersion, Kademlia::CKadUDPKey(), c.bVerified);
+		pContact->SetViaBuddy(c.uBuddyIP, c.uBuddyPort);
+		rResults.push_back(pContact);
+	}
+}
