+// The obfuscated status request, from the client UDP port: the server answers with the UDP key
+// for our IP, obfuscated with the challenge (CServerList::ServerStats does the same from the
+// server UDP socket)
+void CNatTraversal::Impl::ServerPing(DWORD dwNow)
+{
+	uint32 dwChallenge = 0;
+	while (dwChallenge == 0)
+		natd::defaultRandomBytes()(reinterpret_cast<uint8_t*>(&dwChallenge), sizeof dwChallenge);
+	BYTE abyPing[4 + 15];
+	natd::defaultRandomBytes()(abyPing, sizeof abyPing);
+	PokeUInt32(abyPing, dwChallenge);
+	const size_t nLen = 4 + (abyPing[4] & 0x0f);	// up to 15 bytes of padding
+	server.dwChallenge = dwChallenge;
+	server.dwPinged = dwNow;
+	++server.nPings;
+	theStats.AddUpDataOverheadServer((uint32)nLen);
+	io.send(kPrimarySocket, natd::Endpoint{ntohl(server.dwIP), (uint16)(server.nPort + 12)}, abyPing, nLen);
+}
+
+// <target ID 4><our ID 4>, from the client UDP port: the server forwards it with the endpoint it
+// saw it come from. False without the server's UDP key.
+bool CNatTraversal::Impl::ServerRequest(uint32 nTargetID)
+{
+	if (server.dwKey == 0)
+		return false;
+	BYTE abyBuf[64];
+	BYTE *pPacket = abyBuf + CClientUDPSocket::ServerOverheadSize();
+	pPacket[0] = OP_EDONKEYPROT;
+	pPacket[1] = OP_NAT_CALLBACK_REQUEST;
+	PokeUInt32(pPacket + 2, nTargetID);
+	PokeUInt32(pPacket + 6, server.nID);
+	const uint32 nLen = CClientUDPSocket::EncryptForServer(abyBuf, 10, server.dwKey);
+	theStats.AddUpDataOverheadServer(nLen);
+	io.send(kPrimarySocket, natd::Endpoint{ntohl(server.dwIP), server.nObfuscationPort}, abyBuf, nLen);
+	return true;
+}
+
+bool CNatTraversal::OnServerDatagram(BYTE *pData, int nLen, const SOCKADDR_IN &from)
+{
+	Impl::SServer &sv = m_pImpl->server;
+	const uint16 nPort = ntohs(from.sin_port);
+	if (sv.dwIP == 0 || from.sin_addr.s_addr != sv.dwIP || (nPort != (uint16)(sv.nPort + 12) && nPort != sv.nObfuscationPort))
+		return false;
+	const uint32 dwKey = sv.dwKey != 0 ? sv.dwKey : sv.dwChallenge;
+	if (dwKey == 0)
+		return true;
+	BYTE *pPacket;
+	const int nPacket = CClientUDPSocket::DecryptFromServer(pData, nLen, &pPacket, dwKey, from);
+	if (nPacket < 2 || pPacket == pData || pPacket[0] != OP_EDONKEYPROT)
+		return true;	// only obfuscated ones
+	theStats.AddDownDataOverheadServer((uint32)nPacket);
+	if (pPacket[1] == OP_GLOBSERVSTATRES) {
+		if (sv.dwKey == 0 && nPacket >= 2 + 40 && PeekUInt32(pPacket + 2) == sv.dwChallenge) {
+			sv.nObfuscationPort = PeekUInt16(pPacket + 2 + 32);
+			if (sv.nObfuscationPort == 0)
+				sv.nObfuscationPort = (uint16)(sv.nPort + 12);
+			sv.dwKey = PeekUInt32(pPacket + 2 + 36);
+			if (thePrefs.GetVerbose())
+				AddDebugLogLine(false, _T("NAT traversal: punches can be asked through the server %s:%u (UDP port %u)"), (LPCTSTR)ipstr(sv.dwIP), sv.nPort, sv.nObfuscationPort);
+		}
+	} else if (pPacket[1] == OP_NAT_CALLBACK_UDP)
+		OnServerCallback(pPacket + 2, (uint32)(nPacket - 2));
+	return true;
+}
+
+// Lugdunum's NAT callback: <IP 4><UDP port 2> as the server saw them, then the request
+void CNatTraversal::OnServerCallback(const BYTE *pData, uint32 nSize)
+{
+	if (!m_pImpl->server.Ready() || nSize < 6)
+		return;
+	CSafeMemFile data(pData, nSize);
+	const uint32 dwIP = data.ReadUInt32();
+	const uint16 nPort = data.ReadUInt16();
+	SNatCallback cb;
+	if (!ReadCallback(data, dwIP, nPort, cb) || cb.nID == 0) {
+		if (thePrefs.GetVerbose())
+			AddDebugLogLine(false, _T("NAT traversal: punch request through the server from %s:%u not taken: no user hash or no ID"), (LPCTSTR)ipstr(dwIP), nPort);
+		return;
+	}
+	OnServerPeer(cb);
+}
+
+void CNatTraversal::DropWait(uint32 nTargetID, int nError)
+{
+	const std::map<uint32, Impl::SServerWait>::iterator it = m_pImpl->serverWaits.find(nTargetID);
+	if (it == m_pImpl->serverWaits.end())
+		return;
+	CNatdSocketLayer *pLayer = it->second.pLayer;
+	m_pImpl->serverWaits.erase(it);
+	pLayer->m_nServerTarget = 0;
+	if (nError != 0)
+		pLayer->RaiseEvent(FD_CONNECT, nError);
+}
+
+// A request the server forwarded. The target we asked, asking back: our socket gets the punch.
+// Anyone else asks us to punch: we do, the socket is made when the stream opens, and we ask back
+// so that it learns where we are. Each request goes twice (UDP): a peer counts once. The lower
+// ID starts the punch. Two LowIDs that asked each other at once take each other's request for the
+// answer: both sockets then get the one punch and both send their hello, which eMule answers as
+// a repeated one. Should both crypt layers start the handshake, that connection fails, and the
+// next ask, no longer at once, gets through.
+void CNatTraversal::OnServerPeer(const SNatCallback &cb)
+{
+	Impl &impl = *m_pImpl;
+	const bool bConnect = impl.server.nID < cb.nID;
+	const DWORD dwNow = ::GetTickCount();
+	const std::map<uint32, DWORD>::const_iterator itSeen = impl.serverSeen.find(cb.nID);
+	if (itSeen != impl.serverSeen.end() && dwNow - itSeen->second < NATD_SERVER_SEEN)
+		return;
+	impl.serverSeen[cb.nID] = dwNow;
+	// what both sides know: the user hash of the one that starts and both IDs, its own first
+	const natd::TxId token(bConnect ? TokenFrom(thePrefs.GetUserHash(), ServerNonce(impl.server.nID, cb.nID))
+		: TokenFrom(cb.abyHash, ServerNonce(cb.nID, impl.server.nID)));
+	const std::map<uint32, Impl::SServerWait>::const_iterator it = impl.serverWaits.find(cb.nID);
+	if (it != impl.serverWaits.end()) {
+		CNatdSocketLayer *pLayer = it->second.pLayer;
+		DropWait(cb.nID, 0);
+		pLayer->m_dwIP = cb.dwIP;
+		pLayer->m_nPort = cb.nPort;
+		memcpy(pLayer->m_abyToken, token.data(), sizeof pLayer->m_abyToken);
+		if (pLayer->GetLayerState() != connecting || !OpenSession(cb.dwIP, cb.nPort, token.data(), bConnect, pLayer, NATD_VIA_SERVER))
+			pLayer->RaiseEvent(FD_CONNECT, WSAECONNREFUSED);
+		return;
+	}
+	if (OpenSession(cb.dwIP, cb.nPort, token.data(), bConnect, NULL, NATD_VIA_SERVER) && impl.ServerRequest(cb.nID))
+		impl.serverAgain.emplace_back(cb.nID, dwNow);
+}
+
+void CNatTraversal::ForgetLayer(CNatdSocketLayer *pLayer)
+{
+	const std::map<uint32, Impl::SServerWait>::iterator it = m_pImpl->serverWaits.find(pLayer->m_nServerTarget);
+	if (it != m_pImpl->serverWaits.end() && it->second.pLayer == pLayer)
+		m_pImpl->serverWaits.erase(it);
+	pLayer->m_nServerTarget = 0;
 }
 
