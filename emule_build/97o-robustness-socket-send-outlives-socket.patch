 IMPLEMENT_DYNAMIC(CEMSocket, CEncryptedStreamSocket)
 
+namespace
+{
+	// 97o: a send still in flight when its socket let go of it. When the send ends, its status is
+	// written into the OVERLAPPED, and until then the buffers may still be read, so both wait here.
+	struct AbandonedSend
+	{
+		WSAOVERLAPPED *pOverlapped;
+		CArray<WSABUF> aBuffer;
+		DWORD dwEnded; // when the send was first seen ended, 0 before
+	};
+
+	CCriticalSection s_lockAbandonedSends;
+	CList<AbandonedSend*> s_listAbandonedSends;
+}
+
+// 97o: called by the throttler thread, which started the sends; under Wine their end is written
+// when that thread runs, not when another one cancels them.
+void CEMSocket::FreeFinishedAbandonedSends()
+{
+	CSingleLock lockAbandoned(&s_lockAbandonedSends, TRUE);
+	const DWORD dwNow = ::GetTickCount();
+	for (POSITION pos = s_listAbandonedSends.GetHeadPosition(); pos != NULL;) {
+		const POSITION posCur = pos;
+		AbandonedSend *pAbandoned = s_listAbandonedSends.GetNext(pos);
+		if (!HasOverlappedIoCompleted(pAbandoned->pOverlapped))
+			continue;
+		// keep it one more second after its end is first seen, as a margin
+		if (pAbandoned->dwEnded == 0) {
+			pAbandoned->dwEnded = dwNow ? dwNow : 1;
+			continue;
+		}
+		if (dwNow - pAbandoned->dwEnded < SEC2MS(1))
+			continue;
+		for (INT_PTR i = pAbandoned->aBuffer.GetCount(); --i >= 0;)
+			delete[] pAbandoned->aBuffer[i].buf;
+		delete pAbandoned->pOverlapped;
+		delete pAbandoned;
+		s_listAbandonedSends.RemoveAt(posCur);
+	}
+}
