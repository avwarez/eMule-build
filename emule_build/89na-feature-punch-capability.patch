index 0000000..c9360dd
--- /dev/null
+++ b/srchybrid/PunchRegistry.cpp
@@ -0,0 +1,300 @@
+//this file is part of eMule
+//Copyright (C)2002-2026 Merkur ( strEmail.Format("%s@%s", "devteam", "emule-project.net") / https://www.emule-project.net )
