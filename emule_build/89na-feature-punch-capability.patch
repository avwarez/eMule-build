+	bool	MakeRoom(uint32 dwIP, bool bVerified);
+
+	PeerMap	m_mapPeers;
+	SPunchRegistryStats m_stats;
+	DWORD	m_dwLastSaved;
+	uint32	m_uOwnCaps;
+	bool	m_bDirty;
+};
