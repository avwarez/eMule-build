+//along with this program; if not, write to the Free Software
+//Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+#include "stdafx.h"
+#include "emule.h"
+#include "PunchRegistry.h"
+#include "IPFilter.h"
+#include "Preferences.h"
+#include "SafeFile.h"
+#include "opcodes.h"
+#include "OtherFunctions.h"
+#include "Log.h"
+#include "kademlia/kademlia/Kademlia.h"
+#include "kademlia/kademlia/Prefs.h"
+#include "kademlia/kademlia/UDPFirewallTester.h"
+
+#ifdef _DEBUG
+#define new DEBUG_NEW
+#undef THIS_FILE
+static char THIS_FILE[] = __FILE__;
+#endif
+
+
+#define PUNCHPEERS_FILENAME		_T("punchpeers.dat")
+#define PUNCHPEERS_VERSION		0x01
+#define PUNCH_REGISTRY_MAX		512			// entries
+#define PUNCH_REGISTRY_PER_IP	4			// entries of one IP (CGNAT, several clients behind one NAT)
+#define PUNCH_REGISTRY_EXPIRE	DAY2S(7)	// not seen for this long, dropped
+
+CPunchRegistry::CPunchRegistry()
+	: m_stats()
+	, m_uOwnCaps()
+	, m_bDirty()
+{
+	Load();
+	m_dwLastSaved = ::GetTickCount();
+}
+
+CPunchRegistry::~CPunchRegistry()
+{
+	if (m_bDirty)
+		Save();
+}
+
+uint32 CPunchRegistry::GetOwnCaps()
+{
+	uint32 uFlags = 0;
+	if (Kademlia::CKademlia::IsRunning()) {
+		if (Kademlia::CUDPFirewallTester::IsVerified() && !Kademlia::CUDPFirewallTester::IsFirewalledUDP(true))
+			uFlags |= PUNCHF_RELAY;
+		// zero until two of the three Kad nodes asked saw the same port, and again if they did not
+		if (Kademlia::CKademlia::GetPrefs()->GetExternalKadPort() != 0)
+			uFlags |= PUNCHF_PUNCHABLE;
+	}
+	if (theApp.IsFirewalled())
+		uFlags |= PUNCHF_LOWID;
+
+	const uint32 uCaps = (uFlags << 8) | PUNCH_PROTOCOL_VERSION;
+	if (uCaps != m_uOwnCaps) {
+		m_uOwnCaps = uCaps;
+		++m_stats.uOwnCapsChanges;
+	}
+	return uCaps;
+}
+
+EPunchUpdate CPunchRegistry::Update(uint32 dwIP, uint16 nUDPPort, uint32 uCaps, EPunchSource eSource, bool bVerified
+	, const uchar *pKadID, const uchar *pUserHash)
+{
+	++(eSource == PUNCHSRC_KAD ? m_stats.uKadTags : m_stats.uEd2kTags);
+	const EPunchUpdate eResult = Store(dwIP, nUDPPort, uCaps, eSource, bVerified, pKadID, pUserHash);
+	switch (eResult) {
+	case PUNCHUPD_ADDED:
+		++m_stats.uAdded;
+		break;
+	case PUNCHUPD_MOVED:
+		++m_stats.uMoved;
+		break;
+	case PUNCHUPD_CHANGED:
+		++m_stats.uChanged;
+		break;
+	case PUNCHUPD_REFRESHED:
+		++m_stats.uRefreshed;
+		break;
+	default:
+		++m_stats.uRejected;
+	}
+	return eResult;
+}
+
+EPunchUpdate CPunchRegistry::Store(uint32 dwIP, uint16 nUDPPort, uint32 uCaps, EPunchSource eSource, bool bVerified
+	, const uchar *pKadID, const uchar *pUserHash)
+{
+	const uint8 byVersion = PunchCapsVersion(uCaps);
+	const uint8 byFlags = PunchCapsFlags(uCaps);
+	if (byVersion == 0 || dwIP == 0 || nUDPPort == 0)
+		return PUNCHUPD_INVALID;
+	if (theApp.ipfilter->IsFiltered(dwIP))
+		return PUNCHUPD_FILTERED;
+
+	const uint64 uKey = Key(dwIP, nUDPPort);
+	EPunchUpdate eResult;
+	PeerMap::iterator it = m_mapPeers.find(uKey);
+	if (it != m_mapPeers.end()) {
+		// a spoofed Kad request must not rewrite what a reply or a connection proved
+		if (it->second.bVerified && !bVerified)
+			return PUNCHUPD_UNVERIFIED;
+		eResult = (it->second.byVersion != byVersion || it->second.byFlags != byFlags) ? PUNCHUPD_CHANGED : PUNCHUPD_REFRESHED;
+	} else {
+		it = FindSameIdentity(dwIP, pKadID, pUserHash);
+		if (it != m_mapPeers.end()) {
+			if (it->second.bVerified && !bVerified)
+				return PUNCHUPD_UNVERIFIED;
+			SPunchPeer peer(it->second);
+			m_mapPeers.erase(it);
+			peer.nUDPPort = nUDPPort;
+			it = m_mapPeers.emplace(uKey, peer).first;
+			eResult = PUNCHUPD_MOVED;
+		} else {
+			if (!MakeRoom(dwIP, bVerified))
+				return PUNCHUPD_NOROOM;
+			SPunchPeer peer = {};
+			peer.dwIP = dwIP;
+			peer.nUDPPort = nUDPPort;
+			it = m_mapPeers.emplace(uKey, peer).first;
+			eResult = PUNCHUPD_ADDED;
+		}
+	}
+
+	SPunchPeer &peer = it->second;
+	peer.byVersion = byVersion;
+	peer.byFlags = byFlags;
+	peer.bySources |= eSource;
+	if (bVerified)
+		peer.bVerified = true;
+	peer.tLastSeen = (uint32)time(NULL);
+	if (pKadID != NULL && !isnulmd4(pKadID))
+		md4cpy(peer.abyKadID, pKadID);
+	if (pUserHash != NULL && !isnulmd4(pUserHash))
+		md4cpy(peer.abyUserHash, pUserHash);
+	m_bDirty = true;
+	return eResult;
+}
+
+// Only on the same IP: matching an ID seen on another IP would let anyone move a peer away
+CPunchRegistry::PeerMap::iterator CPunchRegistry::FindSameIdentity(uint32 dwIP, const uchar *pKadID, const uchar *pUserHash)
+{
+	const bool bKadID = pKadID != NULL && !isnulmd4(pKadID);
+	const bool bUserHash = pUserHash != NULL && !isnulmd4(pUserHash);
+	if (bKadID || bUserHash) {
+		const PeerMap::iterator itEnd = m_mapPeers.upper_bound(Key(dwIP, 0xFFFF));
+		for (PeerMap::iterator it = m_mapPeers.lower_bound(Key(dwIP, 0)); it != itEnd; ++it)
+			if ((bKadID && md4equ(it->second.abyKadID, pKadID)) || (bUserHash && md4equ(it->second.abyUserHash, pUserHash)))
+				return it;
+	}
+	return m_mapPeers.end();
+}
+
+// Drops the entry seen longest ago, of the same IP if it has too many, else of all if the list
+// is full. Unverified entries go first, and an unverified one never pushes out a verified one:
+// spoofed Kad requests must not be able to empty the list of the peers really seen.
+bool CPunchRegistry::MakeRoom(uint32 dwIP, bool bVerified)
+{
+	PeerMap::iterator itBegin = m_mapPeers.lower_bound(Key(dwIP, 0));
+	PeerMap::iterator itEnd = m_mapPeers.upper_bound(Key(dwIP, 0xFFFF));
+	size_t nInRange = 0;
+	for (PeerMap::iterator it = itBegin; it != itEnd; ++it)
+		++nInRange;
+	uint32 *puEvicted = &m_stats.uEvictedPerIP;
+	if (nInRange < PUNCH_REGISTRY_PER_IP) {
+		if (m_mapPeers.size() < PUNCH_REGISTRY_MAX)
+			return true;
+		itBegin = m_mapPeers.begin();
+		itEnd = m_mapPeers.end();
+		puEvicted = &m_stats.uEvictedFull;
+	}
+
+	PeerMap::iterator itOldest = m_mapPeers.end();
+	for (PeerMap::iterator it = itBegin; it != itEnd; ++it)
+		if (itOldest == m_mapPeers.end()
+			|| (itOldest->second.bVerified && !it->second.bVerified)
+			|| (itOldest->second.bVerified == it->second.bVerified && it->second.tLastSeen < itOldest->second.tLastSeen))
+		{
+			itOldest = it;
+		}
+	if (itOldest == m_mapPeers.end() || (itOldest->second.bVerified && !bVerified))
+		return false;
+	m_mapPeers.erase(itOldest);
+	++*puEvicted;
+	return true;
+}
+
+void CPunchRegistry::Process()
+{
+	if (m_bDirty && ::GetTickCount() >= m_dwLastSaved + MIN2MS(23))
+		Save();
+}
+
+bool CPunchRegistry::Load()
+{
+	CSafeBufferedFile file;
+	if (!CFileOpen(file
+		, thePrefs.GetMuleDirectory(EMULE_CONFIGDIR) + PUNCHPEERS_FILENAME
+		, CFile::modeRead | CFile::osSequentialScan | CFile::typeBinary | CFile::shareDenyWrite
+		, _T("Failed to load ") PUNCHPEERS_FILENAME))
+	{
+		return false;
+	}
+
+	try {
+		if (file.ReadUInt8() != PUNCHPEERS_VERSION) {
+			file.Close();
+			return false;
+		}
+		const uint32 tExpired = (uint32)time(NULL) - PUNCH_REGISTRY_EXPIRE;
+		for (uint32 i = file.ReadUInt32(); i > 0; --i) {
+			SPunchPeer peer;
+			peer.dwIP = file.ReadUInt32();
+			peer.nUDPPort = file.ReadUInt16();
+			peer.byVersion = file.ReadUInt8();
+			peer.byFlags = file.ReadUInt8();
+			peer.bySources = file.ReadUInt8();
+			peer.bVerified = file.ReadUInt8() != 0;
+			peer.tLastSeen = file.ReadUInt32();
+			file.ReadHash16(peer.abyKadID);
+			file.ReadHash16(peer.abyUserHash);
+			++m_stats.uLoadRead;
+			if (peer.byVersion == 0 || peer.dwIP == 0 || peer.nUDPPort == 0 || peer.tLastSeen < tExpired
+				|| m_mapPeers.size() >= PUNCH_REGISTRY_MAX)
+			{
+				++m_stats.uLoadDropped;
+			} else
+				m_mapPeers.emplace(Key(peer.dwIP, peer.nUDPPort), peer);
+		}
+		file.Close();
+		return true;
+	} catch (CFileException *ex) {
+		// a damaged list is only a list to fill again; keep what was read
+		ex->Delete();
+	}
+	return false;
+}
+
+void CPunchRegistry::Save()
+{
+	m_dwLastSaved = ::GetTickCount();
+
+	const uint32 tExpired = (uint32)time(NULL) - PUNCH_REGISTRY_EXPIRE;
+	for (PeerMap::iterator it = m_mapPeers.begin(); it != m_mapPeers.end();)
+		if (it->second.tLastSeen < tExpired) {
+			it = m_mapPeers.erase(it);
+			++m_stats.uExpired;
+		} else
+			++it;
+
+	CSafeBufferedFile file;
+	if (!CFileOpen(file
+		, thePrefs.GetMuleDirectory(EMULE_CONFIGDIR) + PUNCHPEERS_FILENAME
+		, CFile::modeCreate | CFile::modeWrite | CFile::typeBinary | CFile::shareDenyWrite
+		, _T("Failed to save ") PUNCHPEERS_FILENAME))
+	{
+		return;
+	}
+
+	::setvbuf(file.m_pStream, NULL, _IOFBF, 16384);
+	try {
+		file.WriteUInt8(PUNCHPEERS_VERSION);
+		file.WriteUInt32((uint32)m_mapPeers.size());
+		for (PeerMap::const_iterator it = m_mapPeers.begin(); it != m_mapPeers.end(); ++it) {
+			const SPunchPeer &peer = it->second;
+			file.WriteUInt32(peer.dwIP);
+			file.WriteUInt16(peer.nUDPPort);
+			file.WriteUInt8(peer.byVersion);
+			file.WriteUInt8(peer.byFlags);
+			file.WriteUInt8(peer.bySources);
+			file.WriteUInt8(static_cast<uint8>(peer.bVerified));
+			file.WriteUInt32(peer.tLastSeen);
+			file.WriteHash16(peer.abyKadID);
+			file.WriteHash16(peer.abyUserHash);
+		}
+		CommitAndClose(file);
+		m_bDirty = false;
+		m_stats.uSaved = (uint32)m_mapPeers.size();
+	} catch (CFileException *ex) {
+		LogError(LOG_STATUSBAR, _T("%s%s"), _T("Failed to save ") PUNCHPEERS_FILENAME, (LPCTSTR)CExceptionStrDash(*ex));
+		ex->Delete();
+	}
+}
