+//along with this program; if not, write to the Free Software
+//Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+#pragma once
+#include <map>
+
+// UDP hole punching works only between clients which carry it. They tell each
+// other with one tag, sent in the Kad hello (KADEMLIA2_HELLO_REQ/RES) and in
+// the eD2K hello (OP_HELLO/OP_HELLOANSWER) under the same name; every other
+// client skips a tag it does not know. The peers seen with it are kept in
+// punchpeers.dat, to have someone to ask later on.
+#define TAG_PUNCHCAPS			"PUNCH"	// <uint32>
+
+// value of TAG_PUNCHCAPS
+// 16 reserved
+//  8 flags (PUNCHF_*)
+//  8 punch protocol version
+#define PUNCH_PROTOCOL_VERSION	1
+#define PUNCHF_RELAY			0x01	// UDP verified open: can pass on the punch requests of others
+#define PUNCHF_PUNCHABLE		0x02	// Kad found one external UDP port for all (the NAT is not symmetric)
+#define PUNCHF_LOWID			0x04	// TCP firewalled
+
+inline uint8 PunchCapsVersion(uint32 uCaps)	{ return (uint8)uCaps; }
+inline uint8 PunchCapsFlags(uint32 uCaps)	{ return (uint8)(uCaps >> 8); }
+
+enum EPunchSource : uint8
+{
+	PUNCHSRC_KAD = 0x01,
+	PUNCHSRC_ED2K = 0x02
+};
+
+enum EPunchUpdate : uint8
+{
+	PUNCHUPD_ADDED,		// endpoint not known before
+	PUNCHUPD_MOVED,		// same Kad ID or userhash on the same IP, another port: its NAT mapping changed
+	PUNCHUPD_CHANGED,	// endpoint known, version or flags changed
+	PUNCHUPD_REFRESHED,	// endpoint known, nothing changed
+	PUNCHUPD_INVALID,	// rejected: no version, no IP or no port
+	PUNCHUPD_FILTERED,	// rejected: IP filtered
+	PUNCHUPD_UNVERIFIED,	// rejected: unverified IP over a verified entry
+	PUNCHUPD_NOROOM		// rejected: unverified IP, and only verified entries to drop for it
+};
+
+struct SPunchPeer
+{
+	uint32	dwIP;			// network order
+	uint16	nUDPPort;		// the one seen from outside (Kad) or the one told (eD2K)
+	uint8	byVersion;
+	uint8	byFlags;
+	uint8	bySources;		// EPunchSource
+	bool	bVerified;		// IP proven by a TCP connection, a Kad response or a keyed Kad request
+	uint32	tLastSeen;
+	uchar	abyKadID[16];	// all zero when not known
+	uchar	abyUserHash[16];
+};
+
+struct SPunchRegistryStats
+{
+	uint32	uKadTags;		// tags received
+	uint32	uEd2kTags;
+	uint32	uAdded;			// EPunchUpdate results
+	uint32	uMoved;
+	uint32	uChanged;
+	uint32	uRefreshed;
+	uint32	uRejected;		// all the reasons
+	uint32	uEvictedPerIP;	// dropped to make room
+	uint32	uEvictedFull;
+	uint32	uExpired;
+	uint32	uOwnCapsChanges;
+	uint32	uLoadRead;		// punchpeers.dat at startup
+	uint32	uLoadDropped;
+	uint32	uSaved;			// entries in the last save
+};
+
+class CPunchRegistry
+{
+public:
+	CPunchRegistry();
+	~CPunchRegistry();
+
+	uint32	GetOwnCaps();
+	EPunchUpdate Update(uint32 dwIP, uint16 nUDPPort, uint32 uCaps, EPunchSource eSource, bool bVerified
+						, const uchar *pKadID, const uchar *pUserHash);
+	void	Process();
+	void	Save();
