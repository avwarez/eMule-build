+		if (lEvents & FD_WRITE)
+			s.pLayer->RaiseEvent(FD_WRITE, 0);
+		if ((lEvents & FD_CLOSE) && !s.bClosePosted) {
+			s.bClosePosted = true;
+			s.pLayer->RaiseEvent(FD_CLOSE, s.nPendingError);
