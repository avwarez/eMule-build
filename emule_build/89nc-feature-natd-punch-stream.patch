+SSession* CNatTraversal::Impl::NewSession(bool bIncoming, const natd::Endpoint &remote, const natd::TxId &token)
+{
+	if (sessions.size() >= NATD_MAX_SESSIONS)
+		return NULL;
+	std::unique_ptr<SSession> p(std::make_unique<SSession>());
+	p->nId = nNextId++;
+	if (nNextId == 0)
+		nNextId = 1;
+	p->bIncoming = bIncoming;
+	p->remote = remote;
+	p->token = token;
+	SSession *pSession = p.get();
+	sessions[pSession->nId] = std::move(p);
+	return pSession;
+}
+
+size_t CNatTraversal::Impl::Punching() const
+{
+	size_t n = 0;
+	for (std::map<uint32, std::unique_ptr<SSession>>::const_iterator it = sessions.begin(); it != sessions.end(); ++it)
+		n += (it->second->pPunch && !it->second->pStream && !it->second->bOver);
+	return n;
+}
+
+// The request came: punch now, or wait for a free punch session. The requests come in bursts
+// (all the downloaders of one search round), and the other side keeps punching for 15 s.
+void CNatTraversal::Impl::StartPunch(SSession &s, natd::TimePoint now)
+{
+	if (Punching() >= NATD_MAX_PUNCHES) {
+		if (waiting.size() >= NATD_MAX_WAITING) {
+			Failed(s, WSAECONNREFUSED);
+			return;
+		}
+		s.dwQueued = ::GetTickCount();
+		waiting.push_back(s.nId);
+		return;
+	}
+	natd::PunchSessionConfig pc;
+	pc.plan = natd::planDirect(profile, s.remote);
+	if (pc.plan.strategy == natd::PunchStrategy::Infeasible) {
+		Failed(s, WSAECONNREFUSED);
+		return;
+	}
+	pc.token = s.token;
+	pc.startAt = now;
+	pc.remoteIp = s.remote.ip;
+	pc.primarySocket = kPrimarySocket;
+	s.pPunch = std::make_unique<natd::PunchSession>(pc, io);
+	if (thePrefs.GetVerbose())
+		AddDebugLogLine(false, _T("NAT traversal: punching towards %s (%s)"), (LPCTSTR)EndpointStr(s.remote), s.bIncoming ? _T("requested") : _T("requesting"));
+}
+
+void CNatTraversal::Impl::Failed(SSession &s, int nError)
+{
+	s.bOver = true;
+	s.nPendingError = nError;
+	if (s.pLayer != NULL)
+		s.lPendingEvents |= s.bConnected ? FD_CLOSE : FD_CONNECT;
+}
+
+// Same steps as an accepted TCP connection in CListenSocket::OnAccept, but the socket has no
+// TCP connection under it: the layer is the connection.
+void CNatTraversal::Impl::Established(SSession &s, natd::TimePoint now)
+{
+	natd::StreamConfig sc;
+	sc.socket = s.pPunch->establishedSocket();
+	sc.remote = s.pPunch->remoteEndpoint();
+	sc.token = s.token;
+	sc.keepalive = natd::Duration(NATD_STREAM_KEEPALIVE);
+	s.remote = sc.remote;
+	s.pStream = std::make_unique<natd::Stream>(sc, io, now);
+	s.bConnected = true;
+	if (thePrefs.GetVerbose())
+		AddDebugLogLine(false, _T("NAT traversal: punched to %s, stream open"), (LPCTSTR)EndpointStr(s.remote));
+	if (!s.bIncoming) {
+		if (s.pLayer != NULL)
+			s.lPendingEvents |= FD_CONNECT;
+		return;
+	}
+	const uint32 dwIP = htonl(s.remote.ip);
+	if (theApp.listensocket->TooManySockets(true) || theApp.ipfilter->IsFiltered(dwIP) || theApp.clientlist->IsBannedClient(dwIP)) {
+		s.pStream->close(now);
+		s.bOver = true;
+		return;
+	}
+	CClientReqSocket *pSocket = new CClientReqSocket;
+	CNatdSocketLayer *pLayer = new CNatdSocketLayer(dwIP, s.remote.port, s.token.data());
+	pSocket->AttachNatdLayer(pLayer);
+	if (!pSocket->Create()) {
+		pSocket->Safe_Delete();
+		s.pStream->close(now);
+		s.bOver = true;
+		return;
+	}
+	theApp.listensocket->AddConnection();
+	s.pLayer = pLayer;
+	pLayer->Accepted(s.nId);
+}
+
+void CNatTraversal::Impl::PollSessions(natd::TimePoint now)
+{
+	// requests that waited for a free punch session
+	while (!waiting.empty() && Punching() < NATD_MAX_PUNCHES) {
+		SSession *pSession = Find(waiting.front());
+		waiting.pop_front();
+		if (pSession == NULL || pSession->bOver)
+			continue;
+		if (::GetTickCount() - pSession->dwQueued >= NATD_PUNCH_WAIT)
+			Failed(*pSession, WSAETIMEDOUT);
+		else
+			StartPunch(*pSession, now);
+	}
+
+	const DWORD dwNow = ::GetTickCount();
+	for (std::map<uint32, std::unique_ptr<SSession>>::iterator it = sessions.begin(); it != sessions.end();) {
+		SSession &s = *it->second;
+		if (!s.bOver) {
+			if (s.pStream) {
+				s.pStream->poll(now);
+				const natd::StreamState state = s.pStream->state();
+				if (s.pLayer != NULL) {
+					if (s.pStream->readable() > 0)
+						s.lPendingEvents |= FD_READ;
+					if (s.bWantWrite && s.pStream->writable()) {
+						s.bWantWrite = false;
+						s.lPendingEvents |= FD_WRITE;
+					}
+				}
+				if (state == natd::StreamState::Dead) {
+					if (thePrefs.GetVerbose())
+						AddDebugLogLine(false, _T("NAT traversal: stream with %s dead"), (LPCTSTR)EndpointStr(s.remote));
+					Failed(s, WSAECONNRESET);
+				} else if (state == natd::StreamState::Closed || s.pStream->peerClosed()) {
+					if (s.pLayer != NULL)
+						s.lPendingEvents |= FD_CLOSE;
+					else if (state == natd::StreamState::Closed)
+						s.bOver = true;
+				}
+				if (s.pLayer == NULL && dwNow - s.dwDetached >= NATD_LINGER)
+					s.bOver = true;
+			} else if (s.pPunch) {
+				s.pPunch->poll(now);
+				const natd::PunchState state = s.pPunch->state();
+				if (state == natd::PunchState::Established)
+					Established(s, now);
+				else if (state == natd::PunchState::Failed) {
+					if (thePrefs.GetVerbose())
+						AddDebugLogLine(false, _T("NAT traversal: punch towards %s failed"), (LPCTSTR)EndpointStr(s.remote));
+					Failed(s, WSAETIMEDOUT);
+				} else if (!s.bIncoming && s.pLayer == NULL)
+					s.bOver = true;	// the socket gave up
+			}
+		}
+		// freed once the socket is gone and no event is left for it
+		if (s.bOver && s.pLayer == NULL)
+			it = sessions.erase(it);
+		else
+			++it;
+	}
+}
+
+// main thread, cs held
+void CNatTraversal::Impl::RaiseEvents()
+{
+	for (std::map<uint32, std::unique_ptr<SSession>>::const_iterator it = sessions.begin(); it != sessions.end(); ++it) {
+		SSession &s = *it->second;
+		if (s.lPendingEvents == 0 || s.pLayer == NULL)
+			continue;
+		const long lEvents = s.lPendingEvents;
+		s.lPendingEvents = 0;
+		if (lEvents & FD_CONNECT)
+			s.pLayer->RaiseEvent(FD_CONNECT, s.bConnected && !s.bOver ? 0 : (s.nPendingError ? s.nPendingError : WSAETIMEDOUT));
+		if ((lEvents & FD_READ) && !s.bReadPosted) {
+			s.bReadPosted = true;
+			s.pLayer->RaiseEvent(FD_READ, 0);
+		}
+		if (lEvents & FD_WRITE)
+			s.pLayer->RaiseEvent(FD_WRITE, 0);
+		if ((lEvents & FD_CLOSE) && !s.bClosePosted) {
+			if (s.pStream && s.pStream->readable() > 0)
+				s.lPendingEvents |= FD_CLOSE;	// what arrived before the end is read first
+			else {
+				s.bClosePosted = true;
+				s.pLayer->RaiseEvent(FD_CLOSE, s.bOver ? s.nPendingError : 0);
