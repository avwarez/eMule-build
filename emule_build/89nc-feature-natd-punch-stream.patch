+		AddDebugLogLine(false, _T("NAT traversal: punched to %s, stream open, keepalive every %u s"), (LPCTSTR)EndpointStr(r.remote)
+			, (unsigned)(std::chrono::duration_cast<std::chrono::seconds>(r.keepalive).count()));
