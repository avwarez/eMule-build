+	s.remote = r.remote;
+	SSession *pSession = &s;	// a map node: it stays where it is
+	s.pKcp = std::make_unique<CNatdKcpTransport>(r.token, [this, pSession](const uint8_t *pSegment, size_t nLen) { SendPath(*pSession, 0, pSegment, nLen); }, now);
