+// LowID->LowID (CemuleApp::CanDoCallback said no) between two clients that can be punched to,
+// for a file we download from the source: the only case where a punch is tried.
+bool CNatTraversal::CanPunchTo(const CUpDownClient &client) const
+{
+	if (!m_pImpl->pAgent->directPunchable() || !client.IsNatdSource() || client.GetRequestFile() == NULL || thePrefs.GetUDPPort() == 0
+		|| !Kademlia::CKademlia::IsConnected() || !Kademlia::CKademlia::IsFirewalled())
+	{
+		return false;
+	}
+	if (client.GetConnectIP() == 0 || client.GetKadPort() == 0)
+		return false;
+	return client.SupportsDirectUDPCallback() || (client.HasValidBuddyID() && client.GetBuddyIP() != 0 && client.GetBuddyPort() != 0);
+}
+
+// The request carries the marker; the punch goes to the endpoint the index node saw the
+// source publish from (its Kad port), while the source punches to the endpoint the request
+// came from - the one its buddy saw, for a source behind a buddy.
+bool CNatTraversal::AttachOutgoing(CClientReqSocket *pSocket, CUpDownClient &client)
+{
+	if (!CanPunchTo(client))
+		return false;
+	const uint64 nNonce = RandomUInt64();
+	natd::TxId token;
+	CSafeMemFile data(64);
+	if (client.HasValidBuddyID() && client.GetBuddyIP() != 0 && client.GetBuddyPort() != 0) {
+		// through the buddy, which checks the buddy ID and forwards the rest as it is
+		const uchar *pFileHash = client.GetRequestFile()->GetFileHash();
+		data.WriteHash16(client.GetBuddyID());
+		data.WriteHash16(pFileHash);
+		WriteMarker(data, nNonce);
+		token = TokenFrom(pFileHash, nNonce);
+		Packet *packet = new Packet(data, OP_EMULEPROT);
+		packet->opcode = OP_REASKCALLBACKUDP;
+		theStats.AddUpDataOverheadOther(packet->size);
+		// as eMule sends OP_REASKCALLBACKUDP: it does not know the buddy's user hash
+		theApp.clientudp->SendPacket(packet, client.GetBuddyIP(), client.GetBuddyPort(), false, NULL, false, 0);
+	} else {
+		// a source with an open UDP port: after the three fields of OP_DIRECTCALLBACKREQ,
+		// which is all an unpatched client reads
+		data.WriteUInt16(thePrefs.GetPort());
+		data.WriteHash16(thePrefs.GetUserHash());
+		data.WriteUInt8(GetMyConnectOptions(true, false));
+		WriteMarker(data, nNonce);
+		token = TokenFrom(thePrefs.GetUserHash(), nNonce);
+		Packet *packet = new Packet(data, OP_EMULEPROT);
+		packet->opcode = OP_DIRECTCALLBACKREQ;
+		theStats.AddUpDataOverheadOther(packet->size);
+		theApp.clientudp->SendPacket(packet, client.GetConnectIP(), client.GetKadPort(), client.ShouldReceiveCryptUDPPackets(), client.GetUserHash(), false, 0);
+	}
+	if (thePrefs.GetVerbose())
+		AddDebugLogLine(false, _T("NAT traversal: punch requested %s, %s"), client.SupportsDirectUDPCallback() ? _T("directly") : _T("through the buddy"), (LPCTSTR)client.DbgGetClientInfo());
+	pSocket->AttachNatdLayer(new CNatdSocketLayer(client.GetConnectIP(), client.GetKadPort(), token.data()));
+	return true;
+}
+
+bool CNatTraversal::ReadMarker(CSafeMemFile &data, uint64 &nNonce)
+{
+	if (data.GetLength() - data.GetPosition() < NATD_MARKER_SIZE)
+		return false;
+	const ULONGLONG nPos = data.GetPosition();
+	BYTE abyOffer[NATD_MARKER_SIZE];
+	data.Read(abyOffer, sizeof abyOffer);
+	const std::optional<natd::Offer> offer(natd::decodeOffer(abyOffer, sizeof abyOffer));
+	if (!offer || offer->kind != NATD_MARKER_PUNCH) {
+		data.Seek((LONGLONG)nPos, CFile::begin);	// not ours: the rest of the packet is read as before
+		return false;
+	}
+	nNonce = offer->nonce;
+	return true;
+}
+
+void CNatTraversal::StartIncoming(uint32 dwIP, uint16 nPort, const uchar *pKey16, uint64 nNonce)
+{
+	CSingleLock lock(&m_pImpl->cs, TRUE);
+	if (!m_pImpl->pAgent->directPunchable() || dwIP == 0 || nPort == 0)
+		return;
+	const natd::Endpoint remote{ntohl(dwIP), nPort};
+	const natd::TxId token(TokenFrom(pKey16, nNonce));
+	const natd::TimePoint now = natd::Clock::now();
+	// 0 also for a request repeated while the punch it asked for is still on
+	const natd::SessionId id = m_pImpl->pAgent->accept(remote, token, now);
+	if (id == 0)
+		return;
+	SSession &s = m_pImpl->sessions[id];
+	s.token = token;
+	if (thePrefs.GetVerbose())
+		AddDebugLogLine(false, _T("NAT traversal: punching towards %s (requested)"), (LPCTSTR)EndpointStr(remote));
+	m_pImpl->HandleEvents(now);
+}
+
+bool CNatTraversal::Connect(CNatdSocketLayer *pLayer)
+{
+	CSingleLock lock(&m_pImpl->cs, TRUE);
+	natd::TxId token;
+	memcpy(token.data(), pLayer->GetToken(), token.size());
+	const natd::Endpoint remote{ntohl(pLayer->GetIP()), pLayer->GetPort()};
+	const natd::TimePoint now = natd::Clock::now();
+	const natd::SessionId id = m_pImpl->pAgent->connect(remote, token, now);
+	if (id == 0)
+		return false;
+	SSession &s = m_pImpl->sessions[id];
+	s.token = token;
+	s.pLayer = pLayer;
+	pLayer->m_nSession = id;
+	if (thePrefs.GetVerbose())
+		AddDebugLogLine(false, _T("NAT traversal: punching towards %s (requesting)"), (LPCTSTR)EndpointStr(remote));
+	m_pImpl->HandleEvents(now);
+	return true;
+}
+
+int CNatTraversal::Write(uint32 nSession, const void *pBuf, int nLen)
+{
+	CSingleLock lock(&m_pImpl->cs, TRUE);
+	const std::map<natd::SessionId, SSession>::const_iterator it = m_pImpl->sessions.find(nSession);
+	if (it == m_pImpl->sessions.end() || it->second.bOver || it->second.pLayer == NULL || m_pImpl->pAgent->phase(nSession) != natd::SessionPhase::Open) {
+		WSASetLastError(WSAENOTCONN);
+		return SOCKET_ERROR;
+	}
+	// 0: the window is full, a Writable event follows
+	const size_t nWritten = m_pImpl->pAgent->write(nSession, static_cast<const uint8_t*>(pBuf), (size_t)nLen, natd::Clock::now());
+	if (nWritten == 0) {
+		WSASetLastError(WSAEWOULDBLOCK);
+		return SOCKET_ERROR;
+	}
+	return (int)nWritten;
+}
+
+int CNatTraversal::Read(uint32 nSession, void *pBuf, int nLen)
+{
+	CSingleLock lock(&m_pImpl->cs, TRUE);
+	const std::map<natd::SessionId, SSession>::iterator it = m_pImpl->sessions.find(nSession);
+	if (it == m_pImpl->sessions.end() || !it->second.bConnected) {
+		WSASetLastError(WSAENOTCONN);
+		return SOCKET_ERROR;
+	}
+	it->second.bReadPosted = false;
+	size_t nRead = 0;
+	if (nLen > 0)
+		nRead = m_pImpl->pAgent->read(nSession, static_cast<uint8_t*>(pBuf), (size_t)nLen);
+	// what the read caused: Readable again if more is there, Closed once it is all read
+	m_pImpl->HandleEvents(natd::Clock::now());
+	if (nRead == 0) {
+		if (it->second.bOver)
+			return 0;
+		WSASetLastError(WSAEWOULDBLOCK);
+		return SOCKET_ERROR;
+	}
+	return (int)nRead;
+}
+
+// main thread: the layer goes away. A stream is closed with a FIN once what was written is
+// through, and freed after NATD_LINGER at the latest.
+void CNatTraversal::Detach(uint32 nSession)
+{
+	CSingleLock lock(&m_pImpl->cs, TRUE);
+	m_pImpl->pAgent->release(nSession, natd::Clock::now());
+	m_pImpl->sessions.erase(nSession);
+}
+
+///////////////////////////////////////////////////////////////////////////////
+// CNatdSocketLayer
+
+CNatdSocketLayer::CNatdSocketLayer(uint32 dwIP, uint16 nPort, const BYTE *pToken12)
+	: m_nSession()
+	, m_dwIP(dwIP)
+	, m_nPort(nPort)
+{
+	memcpy(m_abyToken, pToken12, sizeof m_abyToken);
+}
+
+CNatdSocketLayer::~CNatdSocketLayer()
+{
+	if (m_nSession != 0 && theApp.nattraversal != NULL)
+		theApp.nattraversal->Detach(m_nSession);
+}
+
+// incoming connection: the socket starts as an accepted one, and the first event makes it connected
+void CNatdSocketLayer::Accepted(uint32 nSession)
+{
+	m_nSession = nSession;
+	SetLayerState(connected);
+	SetOwnerSocketState(attached);
+	TriggerEvent(FD_WRITE, 0, TRUE);
+}
+
+void CNatdSocketLayer::RaiseEvent(long lEvent, int nErrorCode)
+{
+	if (lEvent == FD_CONNECT) {
+		if (nErrorCode == 0)
+			SetLayerState(connected);
+		TriggerEvent(FD_CONNECT, nErrorCode, TRUE);
+		if (nErrorCode == 0)
+			TriggerEvent(FD_WRITE, 0, TRUE);
+	} else
+		TriggerEvent(lEvent, nErrorCode, TRUE);
+}
+
+void CNatdSocketLayer::OnAccept(int)
+{
+}
+
+void CNatdSocketLayer::OnClose(int)
+{
+}
+
+void CNatdSocketLayer::OnConnect(int)
+{
+}
+
+void CNatdSocketLayer::OnReceive(int)
+{
+}
+
+void CNatdSocketLayer::OnSend(int)
+{
+}
+
+void CNatdSocketLayer::Close()
+{
+	if (m_nSession != 0 && theApp.nattraversal != NULL)
+		theApp.nattraversal->Detach(m_nSession);
+	m_nSession = 0;
+	CloseNext();
+}
+
+// The address is the one of the TCP port; the punch goes to the UDP endpoint this layer was made for
+BOOL CNatdSocketLayer::Connect(const LPSOCKADDR, int)
+{
+	if (theApp.nattraversal == NULL || !theApp.nattraversal->Connect(this)) {
+		WSASetLastError(WSAECONNREFUSED);
+		return FALSE;
+	}
+	SetLayerState(connecting);
+	WSASetLastError(WSAEWOULDBLOCK);
+	return FALSE;
+}
+
+bool CNatdSocketLayer::Connect(const CString&, UINT)
+{
+	return Connect(NULL, 0) != FALSE;
+}
+
+BOOL CNatdSocketLayer::GetPeerName(CString &rPeerAddress, UINT &rPeerPort)
+{
+	rPeerAddress = ipstr(m_dwIP);
+	rPeerPort = m_nPort;
+	return TRUE;
+}
+
+BOOL CNatdSocketLayer::GetPeerName(LPSOCKADDR lpPeerAddr, int *lpPeerAddrLen)
+{
+	if (lpPeerAddr == NULL || lpPeerAddrLen == NULL || *lpPeerAddrLen < (int)sizeof(sockaddr_in)) {
+		WSASetLastError(WSAEFAULT);
+		return FALSE;
+	}
+	*reinterpret_cast<sockaddr_in*>(lpPeerAddr) = SockAddr(m_dwIP, m_nPort);
+	*lpPeerAddrLen = (int)sizeof(sockaddr_in);
+	return TRUE;
+}
+
+int CNatdSocketLayer::Receive(void *lpBuf, int nBufLen, int)
+{
+	if (m_nSession == 0 || theApp.nattraversal == NULL) {
+		WSASetLastError(WSAENOTCONN);
+		return SOCKET_ERROR;
+	}
+	return theApp.nattraversal->Read(m_nSession, lpBuf, nBufLen);
+}
+
+int CNatdSocketLayer::Send(const void *lpBuf, int nBufLen, int)
+{
+	const uint32 nSession = m_nSession;
+	if (nSession == 0 || theApp.nattraversal == NULL) {
+		WSASetLastError(WSAENOTCONN);
+		return SOCKET_ERROR;
+	}
+	return theApp.nattraversal->Write(nSession, lpBuf, nBufLen);
+}
+
+BOOL CNatdSocketLayer::ShutDown(int)
+{
+	return TRUE;
+}
