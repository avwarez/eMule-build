+		case natd::AgentEventType::Closed:
+			if (thePrefs.GetVerbose() && e.error != natd::SessionError::None)
+				AddDebugLogLine(false, s.bConnected ? _T("NAT traversal: stream with %s ended: %hs") : _T("NAT traversal: punch towards %s failed: %hs")
+					, (LPCTSTR)EndpointStr(pAgent->remote(e.session)), natd::toString(e.error));
+			if (s.pLayer == NULL) {
+				// an incoming punch that did not get through, or a socket already gone
+				pAgent->release(e.session, now);
+				sessions.erase(it);
+				break;
+			}
+			// as a TCP connection: refused, timed out, or lost
+			s.bOver = true;
+			switch (e.error) {
+			case natd::SessionError::None:		s.nPendingError = 0; break;
+			case natd::SessionError::Refused:	s.nPendingError = WSAECONNREFUSED; break;
+			case natd::SessionError::TimedOut:	s.nPendingError = WSAETIMEDOUT; break;
+			default:							s.nPendingError = WSAECONNRESET;
+			}
+			s.lPendingEvents |= s.bConnected ? FD_CLOSE : FD_CONNECT;
+			break;
+		default:
+			break;
+		}
+	}
+	RaiseEvents();
+}
+
+// Same steps as an accepted TCP connection in CListenSocket::OnAccept, but the socket has no
+// TCP connection under it: the layer is the connection.
+void CNatTraversal::Impl::Accept(natd::SessionId id, SSession &s, natd::TimePoint now)
+{
+	const natd::Endpoint remote(pAgent->remote(id));
+	const uint32 dwIP = htonl(remote.ip);
+	CClientReqSocket *pSocket = NULL;
+	if (!theApp.listensocket->TooManySockets(true) && !theApp.ipfilter->IsFiltered(dwIP) && !theApp.clientlist->IsBannedClient(dwIP)) {
+		pSocket = new CClientReqSocket;
+		CNatdSocketLayer *pLayer = new CNatdSocketLayer(dwIP, remote.port, s.token.data());
+		pSocket->AttachNatdLayer(pLayer);
+		if (pSocket->Create()) {
+			theApp.listensocket->AddConnection();
+			s.pLayer = pLayer;
+			pLayer->Accepted(id);
+			return;
+		}
+		pSocket->Safe_Delete();
+	}
+	pAgent->release(id, now);
+	sessions.erase(id);
+}
+
+// cs held
+void CNatTraversal::Impl::RaiseEvents()
+{
+	for (std::map<natd::SessionId, SSession>::iterator it = sessions.begin(); it != sessions.end(); ++it) {
+		SSession &s = it->second;
+		if (s.lPendingEvents == 0 || s.pLayer == NULL)
+			continue;
+		const long lEvents = s.lPendingEvents;
+		s.lPendingEvents = 0;
+		if (lEvents & FD_CONNECT)
+			s.pLayer->RaiseEvent(FD_CONNECT, s.bConnected && !s.bOver ? 0 : (s.nPendingError ? s.nPendingError : WSAETIMEDOUT));
+		if ((lEvents & FD_READ) && !s.bReadPosted) {
+			s.bReadPosted = true;
+			s.pLayer->RaiseEvent(FD_READ, 0);
+		}
+		if (lEvents & FD_WRITE)
+			s.pLayer->RaiseEvent(FD_WRITE, 0);
+		if ((lEvents & FD_CLOSE) && !s.bClosePosted) {
+			s.bClosePosted = true;
+			s.pLayer->RaiseEvent(FD_CLOSE, s.nPendingError);
 		}
 	}
 }
